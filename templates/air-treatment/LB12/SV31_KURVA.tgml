                Name="" Top="34.0" Width="8.0">
                <Script Name="Activate timer"
                    OnMouseClick="onMouseClick" OnMouseOut="onMouseOut" OnMouseOver="onMouseOver"><![CDATA[/*
Activate timer
*/
function onMouseClick(evt) {
    // Verify leftclick
    if(evt.getButton() != 0) return
    
    // Find bind
    var bind = evt.getCurrentTarget().getElementsByTagName("Bind").item(0);
    if (bind == null) return;
    
    // Activate timer
    if (setValue(bind.getFullBindName(), 1)) {
        // If successful
        evt.getTarget().setAttribute("Stroke", "#808080");
    }
    evt.preventDefault();
}


function onMouseOver(evt){
    evt.getTarget().setAttribute("Stroke","#FF0000");
}

function onMouseOut(evt){
    evt.getTarget().setAttribute("Stroke","#808080");
}]]></Script>
