                    <Component Clip="False" ContentHeight="70"
                        ContentWidth="70" Height="110" Id="Återställ"
                        Left="15" Name="" Top="22" Visibility="Visible"
                        Width="110" ÅterställningFrån="0" ÅterställningTill="1">
                        <Metadata Name="Meta" txtRubrik="Omkopplare"
                            txtStatStopp="Från" txtStatTill="Till"
                            txtStopp="Från" txtTill="Till"/>
                        <Script OnDocumentLoad="OnDocumentLoad"
                            OnMouseClick="" OnMouseOut="" OnMouseOver=""><![CDATA[/*  Driftomkopplare
   Leif Jansson 1/8-07
*/

function OnDocumentLoad(evt)
{
  var Komponent = evt.getCurrentTarget()
  var omk = Komponent.getChildByName("Omkopplare");
  var MetaData = Komponent.getChildByName("Meta");
  										// Hämta texter till omkopplaren
  var txtStopp = MetaData.getAttribute("txtStopp");
  var txtTill = MetaData.getAttribute("txtTill");
  omk.getChildByName("Stopp").setAttribute("Content",txtStopp);
  omk.getChildByName("Till").setAttribute("Content",txtTill);
}]]></Script>
                        <Scale Center="0.5,1" Name="Skalning" ScaleY="1"/>
                        <Bind Name="Value" PreventDefault="True">
                            <Script OnDocumentLoad="OnDocumentLoad"
                                OnMouseClick="OnMouseClick" OnSignalChange="OnSignalChange"><![CDATA[/*  Driftonkopplare
	Leif Jansson 1/8-07
*/
var till;
var från;

function OnDocumentLoad(evt)
{							// Spar fulla namnet till bindningen vid start
	bindValue = null;
    var bind = evt.getCurrentTarget();
	var fullnamn = bind.getFullBindName();
	bind.getParentNode().setAttribute("FullBindName",fullnamn);
        
    till = Number(evt.getCurrentTarget().getParentNode().getAttribute("ÅterställningTill"));
    från = Number(evt.getCurrentTarget().getParentNode().getAttribute("ÅterställningFrån"));
}
function OnMouseClick(evt){
	evt.preventDefault();
}

function OnSignalChange(evt){		// Om signalen ändras
    bindValue = evt.getValue();
    
    
    var Komponent = evt.getCurrentTarget().getParentNode();
	var MetaData = Komponent.getChildByName("Meta");
	var omk = Komponent.getChildByName("Omkopplare");
	var txtStatStopp = MetaData.getAttribute("txtStatStopp");
	var txtStatTill = MetaData.getAttribute("txtStatTill");
    var statusBall = Komponent.getChildByName("StatusBoll");

	var value = new Number(evt.getValue());
	if (value == från){
		omk.getChildByName("Ratt").getChildByName("Pal").getChildByName("Rotation").setAttribute("Angle", 90);
        statusBall.setAttribute("Fill", "#169736");
	}
	else if (value == till){
		omk.getChildByName("Ratt").getChildByName("Pal").getChildByName("Rotation").setAttribute("Angle", 150);
        statusBall.setAttribute("Fill", "#FF0000");
	}	
}]]></Script>
                        </Bind>
                        <Ellipse Fill="#169736" Height="10" Left="55"
                            Name="StatusBoll" Stroke="None" Top="55" Width="10"/>
                        <Component Clip="False" ContentHeight="57.0"
                            ContentWidth="57.33" Height="57.0"
                            Left="7.5" Name="Omkopplare" Top="3.0" Width="57.33">
                            <Group Name="Ratt">
                                <Script OnMouseClick="OnMouseClick"><![CDATA[function OnMouseClick(evt)
{
    var node = null;						// Leta upp 'Bind' noden
	var nodeList = evt.getCurrentTarget().getParentNode().getParentNode().getChildNodes();
    
    var till = Number(evt.getCurrentTarget().getParentNode().getParentNode().getAttribute("ÅterställningTill"));
    var från = Number(evt.getCurrentTarget().getParentNode().getParentNode().getAttribute("ÅterställningFrån"));
    
	for(var i=0; i<nodeList.getLength(); ++i)
	{
		node = nodeList.item(i);
		if(node.getTagName() == "Bind") break;
	}
	if(node == null) return;			// Ingen bindnode hittad, tillbaks
    
    
    
    if(bindValue == till)
    {
        if(confirm("Detta kommer att starta aggregatet igen om knappen inte fjädrat tillbaka av sig själv.\n\nHar du väntat minst 5 sekunder?"))
        {
            setValue(node.getFullBindName(),från);
        }
    }
    else if (bindValue == från)
    {
        if(confirm("Detta återställer förreglingar, om knappen inte fjädrat tillbaka inom någon sekund ställ den manuellt i \"Från\"\n\nVill du fortsätta?"))
        {
            setValue(node.getFullBindName(),till);
        }
    }
}]]></Script>
