                <Script Name="Effects" OnMouseClick=""
                    OnMouseOut="onOut" OnMouseOver="onOver"><![CDATA[function onOver(evt) {
    var target = evt.getTarget();
    if (target.getAttribute("Id") == "RowTarget")
        target.getParentNode().getChild("Bg:hover").setAttribute("Visibility", "Visible");
}

function onOut(evt) {
    var target = evt.getTarget();
    if (target.getAttribute("Id") == "RowTarget")
        target.getParentNode().getChild("Bg:hover").setAttribute("Visibility", "Hidden");
}]]></Script>
