                            <Script Name="EffectsAndInvoke"
                                OnDocumentLoad="OnDocumentLoad"
                                OnMouseClick="OnMouseClick"
                                OnMouseDown="OnMouseDown"
                                OnMouseOut="OnMouseOut"
                                OnMouseOver="OnMouseOver" OnMouseUp="OnMouseUp"><![CDATA[function OnMouseOver(evt)
{
	evt.currentTarget.getChild("Button").setAttribute("Fill", "#F9F8FB"); 
}
function OnMouseOut(evt)
{ 
	evt.currentTarget.getChild("Button").setAttribute("Fill", "#FFFFFF");
}
function OnMouseDown(evt)
{
	evt.currentTarget.getChild("Button").setAttribute("Fill", "#E0E0E0");
}
function OnMouseUp(evt)
{   
    OnMouseOut(evt);
}
function OnMouseClick(evt)
{
	evt.preventDefault();
								// Öppna bild för betjänat system
	var linkname = evt.currentTarget.getElementsByTagName("Link").item(0).getFullBindName();
	invoke(linkname,'OpenInSelf');	
}
function OnDocumentLoad(evt)
{
    var textContent = evt.currentTarget.getChild("Text").getAttribute("Content");
    if (textContent == "xxxx" || textContent == "")
        evt.currentTarget.setAttribute("Visibility","Hidden");
}
]]></Script>
