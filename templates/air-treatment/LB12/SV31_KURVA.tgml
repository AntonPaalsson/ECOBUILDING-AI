                    <Component Clip="False" ContentHeight="100.0"
                        ContentWidth="120.0" Height="100.0"
                        Id="RadioGroup" Left="5.0" Name="MS" Top="25.0" Width="120.0">
                        <Script Name="EffectsAndInvoke"
                            OnMouseClick="onMouseClick"
                            OnMouseDown="onMouseDown"
                            OnMouseOut="onMouseOut"
                            OnMouseOver="onMouseOver"
                            OnMouseUp="onMouseUp" OnSignalChange="onSignal"><![CDATA[function onSignal(evt)
{
    var value = Number(evt.getValue());
    var buttons = evt.getCurrentTarget().getElementsByTagName("Component");
    
    for (var i=0; i < buttons.getLength(); i++) {
        
        var button = buttons.item(i);
        if (button.getAttribute("Id").indexOf("Button_") < 0) continue;     // Not a button
        
        if(Number(button.getAttribute("StatusActive")) == value)            // Does active status match bind value?
            button.getChild("Checked").setAttribute("Visibility", "Visible");
        else
            button.getChild("Checked").setAttribute("Visibility", "Hidden");
            
        button.getChild("Selected").setAttribute("Visibility", "Hidden");
    }
}

function onMouseOver(evt)
{
	var button = evt.target.parentNode;
	button.getChild("Text").setAttribute("TextDecoration","Underline");
}

function onMouseOut(evt)
{
	var button = evt.target.parentNode;
	button.getChild("Text").setAttribute("TextDecoration","None");
    button.getChild("Selected").setAttribute("Visibility","Hidden");
	onMouseUp(evt);
}

function onMouseDown(evt)
{
    var button = evt.target.parentNode;
	button.getChild("Text").setAttribute("FontSize","11");
	button.getChild("Selected").setAttribute("Visibility","Visible");
}

function onMouseUp(evt)
{
	var button = evt.target.parentNode;
	button.getChild("Text").setAttribute("FontSize","12");
}

function onMouseClick(evt)
{
    var button = evt.target.parentNode;
    var buttonText = button.getChild("Text").getAttribute("Content");
    if (!confirm("Aggregatet kommer byta driftläge till '"+ buttonText +"'\n\nVill du fortsätta?")) {
        button.getChild("Selected").setAttribute("Visibility","Hidden");
        return;
    }
    button.getChild("Selected").setAttribute("Visibility","Visible");
	
	var bind = evt.currentTarget.getElementsByTagName("Bind").item(0);
	if (bind == null) return;

	setValue(bind.getFullBindName(), Number(button.getAttribute("StatusActive")));
	evt.preventDefault();
}]]></Script>
