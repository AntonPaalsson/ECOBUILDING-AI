                    <Script Name="Align and Sort"
                        OnDocumentLoad="onLoad" OnSignalChange=""><![CDATA[function onLoad(evt)
{
	var comp = evt.getCurrentTarget();
	align(comp);								//	TA BORT NÄR ALLT ÄR LAGGT RÄTT
}

function align(comp)
{
	var children = comp.getChildNodes();
	var pos = 30;
	
	for (var i=0;i<children.getLength();i++) {
	
        var currcomp = children.item(i);
    
		if(currcomp.getAttribute("Id") == "Checkbox") {
			currcomp.setAttribute("Left", 10);
			currcomp.setAttribute("Top", pos);
            var size =  Number(currcomp.getAttribute("Height"));
			pos = pos + size + 10;
		}
		
	}
}]]></Script>
