                <Metadata
                    Media_custom="(min-width:552) and (min-height:700){&quot;justify-content&quot;:&quot;flex-start&quot;}"
                    Name="Css" Value="&quot;width&quot;:&quot;100%&quot;, &quot;height&quot;:&quot;auto&quot;, &quot;display&quot;:&quot;flex&quot;, &quot;flex-wrap&quot;:&quot;wrap&quot;, &quot;justify-content&quot;:&quot;center&quot;, &quot;items-margin&quot;:&quot;10&quot;"/>
                <Translate Name="SlideTrans">
                    <Animate Animation="Stop" Attribute="Y"
