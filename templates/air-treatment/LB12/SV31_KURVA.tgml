        <Group Id="Module" Name="tags">
            <Script Name="module" OnDocumentLoad="OnDocumentLoad"><![CDATA[var module_info = {
    name: "tags",
    version: "1.0.0-rc1",
    date: "2018-10-04",
    author: "Michel Jansson",
    dependencies: {}
};

var module = {
    module_info: module_info,
    
    find: function(search, startNode) {
        search = module.toTagArray(search);    // Parse search
        if (search == null || search.length == 0) return;
        startNode = startNode || document.documentElement;  // If no start node supplied, start at root
        
        var matches = [];
        
        // Get tagnodes
        var metas = startNode.getElementsByTagName("Metadata");
        for (var i=0, n=metas.getLength() ; i<n ; i++) {
            let meta = metas.item(i);
            if (meta.getAttribute("Name") != "Tag") continue;   // Skip if not a tag
           
            let tags = module.toTagArray(meta.getAttribute("Value"));  // Parse tags
            let isMatch = search.every(function(item){return tags.indexOf(item) > -1}); // Check that every search keyword exists in the tags
            if (isMatch) matches.push(meta.parentNode);
        }
        return matches;
    },
    toTagArray: function(data) {
        if (typeof data == "string" || data instanceof String) {
            data = String(data).split(",");
        }
        // Return if not an array
        if (!Array.isArray(data)) return null;
        // Tidy up the keywords
        return data.map(function(item) {
            return item.replace("#","").trim().toLowerCase();
        });
    }
};

function OnDocumentLoad(evt) { ModuleMaster.register(module, evt); }
]]></Script>
        </Group>
    </Group>
    <Metadata
        Media_min-width_1024="&quot;Width&quot;:&quot;1345&quot;, &quot;Height&quot;:&quot;720&quot;"
        Media_xl="" Name="Css" Value="&quot;Width&quot;:&quot;1345&quot;, &quot;Height&quot;:&quot;720&quot;"/>
    <Component Clip="False" ContentHeight="1.0" ContentWidth="1.0"
        Height="1.0" Id="ResponsiveContainer" Name=""
        Version="1.0.0-rc1" Width="1.0">
        <Metadata
            Media_custom="(min-width:552) and (min-height:700){&quot;translate-y&quot;:&quot;-60%&quot;}"
            Media_max-height_700="" Media_min-width_1024="" Name="Css" Value="&quot;translate-y&quot;:&quot;-47%&quot;"/>
        <Script Name="ResponsivePrepare" OnDocumentLoad="onLoad"><![CDATA[function onLoad(evt)
{
    var comp = evt.currentTarget;
    
    var nodeList = document.documentElement.getChildNodes();
    for (var i=0; i < nodeList.getLength(); i++) {
        var node = nodeList.item(i);
        var nodeName = node.getAttribute("Name");
        
        // A few things not desierd to move
        if (node.isSameNode(comp) || nodeName == "Modules" || node.tagName == "Layer" || nodeName == "Css" || Number(node.getAttribute("Top")) <= 0.5)
            continue;
        comp.appendChild(nodeList.item(i));
        i--;
    }
    
    var w = comp.getBoundingBox().get_Width(); 
    var h = comp.getBoundingBox().get_Height();
    var l = comp.getBoundingBox().get_Left();
    var t = comp.getBoundingBox().get_Top();
    
    var trans = comp.appendChild(document.createElement("Translate"));
    trans.setAttribute("X", l/-1);
    trans.setAttribute("Y", t/-1);
    
    var css = ModuleMaster.require("css");
    css.setAttribute(document.documentElement, "Width", w+10, "value_0");
    css.setAttribute(document.documentElement, "Height", h+80, "value_0");
    css.setAttribute(comp, "width", w);
    css.setAttribute(comp, "height", h);
    css.setAttribute(comp, "left", "5");
    css.setAttribute(comp, "top", "50%");
    css.setAttribute(comp, "translate-x", "0");
    css.setAttribute(comp, "left", "50%", "min-width_1024");
    css.setAttribute(comp, "translate-x", "-55%", "min-width_1024");
    
    css.resize();
}
]]></Script>
    </Component>
