            <Text FontFamily="Arial" FontSize="12" FontStyle="Normal"
                FontWeight="Bold" HorizontalAlign="Left" Label=""
                Left="1210.0" Name="Datum och tid" Stroke="#1C4081"
                TextDecoration="None" Top="45" VerticalAlign="Bottom">
                <Bind Format="Presentation" Name="Fliktid" PreventDefault="True">
                    <Script OnDocumentLoad="" OnSignalChange="OnSignalChange"><![CDATA[function OnSignalChange(evt)
{
  text = evt.getTarget().getParentNode();
  var vdag = "";
  
	if(evt.getStatus() == 0)	// Om status ej kontakt med enhet
  		varde = "--";			// visa streck
  	else						// annars värdet med en decimal
	{  
		var tid = new Date;
		switch(tid.getDay())	// Välj rätt veckodag
		{
			case 1: vdag = "Måndag"; break;
			case 2: vdag = "Tisdag"; break;
			case 3: vdag = "Onsdag"; break;
			case 4: vdag = "Torsdag"; break;
			case 5: vdag = "Fredag"; break;
			case 6: vdag = "Lördag"; break;
			case 7: vdag = "Söndag"; break;
		}
								// Skriv ut datum tid och veckodag
  		text.setAttribute("Content", evt.getPresentationValue() + " - "+ vdag);
  		delete(tid);
  	}	
}
]]></Script>
