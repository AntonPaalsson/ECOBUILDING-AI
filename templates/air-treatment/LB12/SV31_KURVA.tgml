                <Script Name="Slider" OnDocumentLoad="onLoad" OnMouseClick="onClick"><![CDATA[var css = null;

function onLoad(evt)
{
    css = ModuleMaster.require("css");
}

function onClick(evt)
{
    var node = evt.currentTarget;
    var parent = node.parentNode;
    
    // Get translate as set by css module
    var transY = Number(parent.getChild("Css_Translate").getAttribute("Y"));
    
    if (transY != 0) {  // Hidden
        // Show
        parent.getChildByName("Animate").setAttribute("Animation", "Stop");
        parent.getChildByName("SlideTrans").setAttribute("Y", transY);
        parent.getChildByName("Animate").setAttribute("From", transY);
        parent.getChildByName("Animate").setAttribute("Animation", "Start");
        css.setAttribute(parent, "translate-y", "0", null, true);
        node.getChild("Arrow").getChild("Scale").setAttribute("ScaleY", -1);
    }
    else {              // Visible
        // Hide
        css.setAttribute(parent, "translate-y", "99%", null, true);
        node.getChild("Arrow").getChild("Scale").setAttribute("ScaleY", 1);
    }
}
]]></Script>
