            <Script Name="EffectsAndInvoke" OnDocumentLoad="onLoad" OnMouseClick="onClick"><![CDATA[var chimes;
function onClick(evt)
{
    var area = document.getElementById("NotificationAreaRight");
    area.setAttribute("Visibility", area.getAttribute("Visibility") == "Hidden" ? "Visible" : "Hidden");
}

function onLoad(evt)
{
    chimes = evt.currentTarget;
    document.getElementById("NotificationAreaFlexboxRight").addEventListener("SignalChangeEvent", btnSignal, false);
}

function btnSignal(evt) {
    var nodeList = evt.currentTarget.getChildNodes();
    var chimeNo = 1;
    for (var i=0, n=nodeList.getLength(); i<n || chimeNo<=1 ; i++) {
        var node = nodeList.item(i);
        if (node) {
            if (node.getAttribute("Id").indexOf("Button") == -1 || node.getAttribute("Visibility") == "Hidden") continue;
            var fill = nodeList.item(i).getChild("IconBg").getAttribute("Fill");
            chimes.getChild(chimeNo++).setAttribute("Fill", fill);
        }
        else
            chimes.getChild(chimeNo++).setAttribute("Fill", "None");
    }
}
]]></Script>
