                        <Script Name="Effects" OnSignalChange="OnChange"><![CDATA[var vgrad, lg, vvx, g;
function OnChange(evt)
{
    var value = Number(evt.getValue());
    var signalId = evt.target.getAttribute("Id");
    if (signalId == "Verkningsgrad")
        vgrad = value;
    else if (signalId == "Larmgräns")
        lg = value;
    else if (signalId == "StyrsignalVVX")
        vvx = value;
    else if (signalId == "Gräns beräkning")
        g = value;

    if (vgrad && lg && vvx>g) {
        if (vgrad <= lg)
            evt.target.parentNode.setAttribute("Fill","#FF0000");
        else if (vgrad < (lg + (lg * 0.1)))
            evt.target.parentNode.setAttribute("Fill","#E47F00");
        else
            evt.target.parentNode.setAttribute("Fill","#3DCD58");
    }
    else
        evt.target.parentNode.setAttribute("Fill","#C0C0C0");
 }
 ]]></Script>
