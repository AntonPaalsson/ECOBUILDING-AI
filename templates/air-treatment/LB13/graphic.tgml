    <Metadata Name="Css" Value="&quot;width&quot;:&quot;100vw&quot;, &quot;min-width&quot;:&quot;340&quot;, &quot;height&quot;:&quot;auto&quot;"/>
    <Group Name="Modules" Visibility="Hidden">
        <Script Name="ModuleMaster" OnDocumentLoad="OnDocumentLoad"><![CDATA[var module_info = {
    name: "ModuleMaster",
    version: "1.0.0-rc1",
    date: "2018-10-04",
    author: "Michel Jansson"
};

var modules = {}, callbacks = [];

ModuleMaster = {
    require: function(modName) {
        var module = modules[String(modName).toLowerCase()];
        if (module != null)
            return module;
        else
            throw "Module '" +modName+ "' was required but is not loaded (yet?)! Are you requiring to early?";
    },
    isLoaded: function(modName) {
        return (modules[String(modName).toLowerCase()]) ? true:false;
    },
    register: function(module, evt, callback) {
        if (typeof module !== "object" || typeof evt !== "object")
            throw "Unable to register module. Objects was expected";
        else if (typeof module.module_info !== "object")
            throw "Unable to register module. module_info missing";
        
        // Add module
        var modName = String(module.module_info.name).toLowerCase();
        if (modName != "")
            modules[modName] = module;
        else
            throw "Unable to register module. module_info.name missing";
            
        // If callback was supplied, attached eventlistener and add callback to callbacks list
        if (typeof callback === "function") {
            evt.getCurrentTarget().addEventListener("ModulesLoadedEvent", function(evt) {
                try { callback(evt); }
                catch(ex) { alert("Module '" +modName+ "' callback function threw and error:\n\n" +exString(ex)); }
            }, false);
            callbacks.push(evt.getCurrentTarget());
        }
        
        // If last module
        if (!evt.getCurrentTarget().getNextSibling()) {
            this._fireModulesLoaded.call(ModuleMaster);
        }
    },
    _fireModulesLoaded: function() {
        checkDependencies();
        // Create event to trigger the callbacks
        var loadedEvent = view.document.createEvent("Event");
        loadedEvent.initEvent("ModulesLoadedEvent", true, true);
        for (var i in callbacks) {
            callbacks[i].dispatchEvent(loadedEvent);
        }
    }
};

function exString(ex) {
    return ex.name +": " +ex.message+ " (" +ex.fileName+ "#" +ex.lineNumber+ ")";
}

function checkDependencies() {
    /*
    Modules can be dependant on other modules. Each dependency is listed in
    module_info. This function iterates thru and checks if module exists.
    version version can also be specefied. "helpers": ">=1.0.0"
    */
    for (var modName in modules) {
        var module = modules[modName];
        for (var dep in module.module_info.dependencies) {
            var depModule = modules[String(dep).toLowerCase()];
            if (depModule == null) {
                alert("Module '" + module.module_info.name + "' dependes on module '" + dep +"' that is not loaded");
            }
            else {
                var depVer = module.module_info.dependencies[dep];
                if (!isSemVer(depModule.module_info.version, depVer)) {
                    alert("Module '" + module.module_info.name + "' dependes on module '" + dep + " " + depVer + "' but version '"+depModule.module_info.version+"' is loaded");
                }
            }
        }
    }
}

/*!
 * isSemVer - v0.1.1 - 10/04/2018 (Michel Jansson rev)
 * http://benalman.com/
 * http://semver.org/
 * https://gist.github.com/cowboy/566233
 *
 * Copyright (c) 2010 "Cowboy" Ben Alman
 * Dual licensed under the MIT and GPL licenses.
 * http://benalman.com/about/license/
 */
// Returns true if all version criteria are met. Comparison operator defaults
// to == if omitted. Valid comparisons are == != < <= > >=.
//
// isSemVer( my.version, '1.2.3' ) // == is assumed if comparison op excluded
// isSemVer( my.version, '>= 1.2.3', '!= 1.2.4alpha' )
// isSemVer( my.version, '< 2.0', '!= 1.2.3', '!= 1.2.4alpha' )
//
var isSemVer = (function(){
  var re = /^(<|>|[=!<>]=)?\s*(\d+(?:\.\d+){0,2})\-?([a-z][a-z0-9\-]*)?$/i;
  function get_val( str, include_cmp ) {
    var matches = ( str + '' ).match( re );

    return matches
      ? ( include_cmp ? ( matches[1] || '==' ) : '' )
        + '"'
        + ( matches[2] + '.0.0' )
            .match( /\d+(?:\.\d+){0,2}/ )[0]
            .replace( /(?:^|\.)(\d+)/g, function(a,b){
              return Array( 9 - b.length ).join(0) + b;
            })
        + ( matches[3] || '~' )
        + '"'
      : ( include_cmp ? '==0' : 1 );
  };

  return function( base_ver ) {
    base_ver = get_val( base_ver );

    for ( var arg, i = 1; arg = arguments[ i++ ]; ) {
      if ( !(new Function( 'return ' + base_ver + get_val( arg, 1 ) ))() ) {
        return false;
      }
    }
    return true;
  };
})();


function OnDocumentLoad(evt) {}]]></Script>
        <Group Id="Module" Name="helpers">
            <Script Name="module" OnDocumentLoad="OnDocumentLoad"><![CDATA[var module_info = {
    name: "helpers",
    version: "1.0.0-rc1",
    date: "2018-10-04",
    author: "Michel Jansson",
    dependencies: {}
};

var module = {
    module_info: module_info,
    
    varStore: {
        /*
            Storage object that stores stuff with a node as a pointer to the storage unit,
            if store does not exist when trying to getStore(node), it is automatically created
        */
        _vars: [],
        getStore: function (node){
            for (var i in this._vars) {
                if (this._vars[i].node.isSameNode(node))
                    return this._vars[i];
            }
            // No match
            var store = {node: node};
            this._vars.push(store);
            return store;
        }
    },
    enableBinds: function(node) {
        var nodeList = node.getElementsByTagName("Bind");
        for(var i=0, n=nodeList.getLength() ; i<n ; i++) {
            nodeList.item(i).setAttribute("DynamicUpdates","Enable");
        }
    },
    setPreventDefault: function(node, value) {
        for (var tag in {Bind:1, Link:1}) {
            var nodeList = node.getElementsByTagName(tag);
            for(var i=0, n=nodeList.getLength() ; i<n ; i++) {
                nodeList.item(i).setAttribute("PreventDefault", value ? "True" : "False");
            }
        }
    },
    childById: function(node, id) {
        var children = node.getChildNodes();
        for (var i=0, n=children.getLength() ; i<n ; i++) {
            if (children.item(i).getAttribute("Id") == id)
                return children.item(i);
        }
        return null;
    },
    getBindPath: function(node) {
        // Iterate backwards until we hit the Tgml element. Also
        var name = "";
        while(node.tagName != "Tgml") {
            if(node.getTagName() == "Component" && node.getAttribute("Name") != "") {
                if (name != "") name = "." + name;
                name = node.getAttribute("Name") + name;
            }
            node = node.getParentNode();
            
        }
        return name;
    },
    storeInitialBindValues: function() {
        // Stores all the inital values of bind targets, to the bind so it's not lost by a bind update.
        var binds = document.getDocumentElement().getElementsByTagName("Bind");
        for (var i=0; i<binds.getLength() ; i++) {
            var b = binds.item(i);
            b.setAttribute("initialValue", b.parentNode.getAttribute(b.getAttribute("Attribute")));
        }
        this.storeInitialBindValues = function(){return};   // Write over ourselves so we only run once
    }
};

function OnDocumentLoad(evt) { ModuleMaster.register(module, evt); }
]]></Script>
        </Group>
        <Group Id="Module" Name="tooltip">
            <Script Name="module" OnDocumentLoad="OnDocumentLoad"><![CDATA[var module_info = {
    name: "tooltip",    
    version: "2.4.0",
    date: "2018-03-23",
    author: "Christian Rasmussen, Michel Jansson",
    dependencies: {}
};

// Function thats is run after all modules has loaded
var tgml, lib;
function init(evt) {
    // Save some references
    tgml = view.document.getDocumentElement();
    lib = evt.getCurrentTarget();
    
    // Init tooltip
    module.tooltip = new TooltipClass(lib.getChild("Tooltip"));
    
    // Setup global event listeners
    tgml.addEventListener("MouseOverEvent", function(evt){module.over(evt)}, false);
    tgml.addEventListener("MouseOutEvent", function(evt) {module.disable()}, false);
    tgml.addEventListener("MouseMoveEvent", function(evt){module.move(evt)}, false);
};

var module = {
    module_info: module_info,
    
    SAFETYGAP: 30,          // Distance of tooltip from cursor
    followCursor: false,    // Tooltip follows cursor on move
    enableDelay: 1000,      // Delay in MS before tooltip is shown
    disableDelay: 5000,     // Delay in MS before tooltip is hidden
    showTimeout: null,
    hideTimeout: null,
    isEnabled: false,
    
    tooltip: null,
    
    over: function (evt) {
        // Get Tooltip attribute
        var tooltipText = String(evt.getTarget().getAttribute("Tooltip"));

        // Check if there is a tooltip text
        if (tooltipText.length > 0)
            // Enable and move tooltip
            this.enable(tooltipText, evt);
    },
    enable: function (tooltipText, evt) {
        this.willEnable = true;
        // Move tooltip
        if (evt) this.move(evt);
        
        // Show tooltip after delay
        this.showTimeout = setTimeout(function(){
            // Render tooltip
            module.tooltip.render(tooltipText);
            
            // Show the tooltip
            module.tooltip.show();
            
            // Set tooltip status
            module.isEnabled = true;
            module.willEnable = false;
            
            // Start timer to hide tooltip after long time
            module.hideTimeout = setTimeout(function(){ module.disable(); }, module.disableDelay);
        }, this.enableDelay);
    },
    disable: function () {
        // Check that we have anything to disable
        if(this.willEnable) {
            // Reset timers
            if (this.showTimeout != null) {
                clearTimeout(this.showTimeout);
                this.showTimeout = null;
            }
            // Set tooltip status
            this.willEnable = false;
        }
        if(this.isEnabled) {
            // Hide tooltip
            this.tooltip.hide();
            
            // Reset timers
            if (this.hideTimeout != null) {
                clearTimeout(this.hideTimeout);
                this.hideTimeout = null;
            }
            
            // Set tooltip status
            this.isEnabled = false;
        }
    },
    move: function (evt) {
        // Check if move is allowed
        if (this.willEnable || this.isEnabled) {
            // Set new coorinates
            this.tooltip.tooltipX = evt.getScreenX();
            this.tooltip.tooltipY = evt.getScreenY();
                        
            // Check mode if the tooltip should be rendered directly (move with mouse)
            if (this.followCursor) {
                var tooltipText = String(evt.getTarget().getAttribute("Tooltip"));
                if (tooltipText.length > 0)
                    this.tooltip.render(tooltipText);
                else
                    this.tooltip.render(null);
            }
        }
    }
};

function OnDocumentLoad(evt) { ModuleMaster.register(module, evt, init); }

// Tooltip class
function TooltipClass (tooltipNode) {    
    this.node = tooltipNode;
    this.tooltipX;
    this.tooltipY;
    
    // Private vars
    var text = [tooltipNode.getChild("Text")];
	var shade = tooltipNode.getChild("Shade");
	var frame = tooltipNode.getChild("Frame");
    var fadeIn = tooltipNode.getChild("FadeIn");
    var fadeOut = tooltipNode.getChild("FadeOut");
    var width = Number(tooltipNode.getAttribute("Width"));
    var height = Number(tooltipNode.getAttribute("Height"));
	var scaleWidth = width / Number(tooltipNode.getAttribute("ContentWidth"));
	var scaleHeight = height / Number(tooltipNode.getAttribute("ContentHeight"));
    var textMarginLeft = Number(text[0].getAttribute("Left"));
    var textMarginTop = Number(text[0].getAttribute("Top"));
    var textContent;
    
    // Init tooltip
    fadeOut.setAttribute("Animation","Stop");
    fadeIn.setAttribute("Animation","Stop");
    tooltipNode.setAttribute("Opacity", 0);
    
	// Render tooltip
	this.render = function (tooltipText) {
        // Get zoom if possible
        var zoomLevel = (typeof view != "undefined") ? view.zoomLevel : 1;
        
        // Check if in static mode, or if in follow mode if tooltip text has changed
        if (!module.followCursor || (tooltipText != null && textContent != tooltipText)) {
            // Save and update tooltip text
            textContent = tooltipText;
            
            var tooltipWidth = 0;
            var fontSize = Number(text[0].getAttribute("FontSize"));
            
            // Split text into array based on new line
            var textArr = textContent.replace("\n", "\\n").split("\\n");
            for(var row in textArr) {   // Run through all lines
                if(text[row] != null) {
                    text[row].setAttribute("Content", textArr[row]);
                }
                else {
                    // Lazily create new text node for line..
                    text[row] = text[0].cloneNode(true);
                    text[row].setAttribute("Top", (fontSize * row) + textMarginTop);
                    text[row].setAttribute("Content", textArr[row]);
                    this.node.appendChild(text[row]);
                }
                tooltipWidth = Math.max(tooltipWidth, text[row].getBoundingBox().get_Width());
            }
            
            // Delete text rows that are not needed
            while(text.length-1 > row) {
                this.node.removeChild(text.pop());
            }
            
            // Calculate tooltip size
            tooltipWidth += textMarginLeft * 2;
            var tooltipHeight = (fontSize * row) + (fontSize + 2) + (textMarginTop * 2);
            width = (tooltipWidth * scaleWidth) / zoomLevel;
            height = (tooltipHeight * scaleHeight) / zoomLevel;

            // Set tooltip size
            frame.setAttribute("Width", tooltipWidth);
            frame.setAttribute("Height", tooltipHeight);
            shade.setAttribute("Width", tooltipWidth);
            shade.setAttribute("Height", tooltipHeight);
            this.node.setAttribute("ContentWidth", tooltipWidth);
            this.node.setAttribute("ContentHeight", tooltipHeight);
            this.node.setAttribute("Width", width);
            this.node.setAttribute("Height", height);
        }
            
        // Calculate left and top position
        var docWidth = Number(tgml.getAttribute("Width"));
        var docHeight = Number(tgml.getAttribute("Height"));
        var left = (this.tooltipX + width < docWidth) ? this.tooltipX : ((this.tooltipX - width >= 0) ? this.tooltipX - width : 0);
        var top = (this.tooltipY + (module.SAFETYGAP / zoomLevel) + height < docHeight) ? this.tooltipY + (module.SAFETYGAP / zoomLevel) : this.tooltipY - ((module.SAFETYGAP/2) / zoomLevel) - height;

        // Set new position
        this.node.setAttribute("Left", left);
        this.node.setAttribute("Top", top);
        
        // Place ontop
        tgml.appendChild(this.node);
	};
    this.show = function() {
        fadeOut.setAttribute("Animation","Stop");
        fadeIn.setAttribute("Animation","Start");
    };
    this.hide = function() {
        fadeIn.setAttribute("Animation","Stop");
        fadeOut.setAttribute("Animation","Start");
    };
}
]]></Script>
            <Component Clip="False" ContentHeight="21.0"
                ContentWidth="100.0" Height="21.0" Id="" Left="0.0"
                Name="Tooltip" Opacity="1" Top="0.0"
                Visibility="Visible" Width="100.0">
                <Rectangle Fill="#808080" Height="21.0" Left="2.0"
                    Name="Shade" Opacity="0.5" RadiusX="3.0"
                    RadiusY="3.0" Stroke="#808080" StrokeDashArray="0.0"
                    StrokeWidth="1.0" Top="2.0" Visibility="Visible" Width="100.0"/>
                <Rectangle Fill="#FAFAFE" Height="21.0" Left="0.0"
                    Name="Frame" RadiusX="2.0" RadiusY="2.0"
                    Stroke="#404040" StrokeDashArray="0.0"
                    StrokeWidth="1.0" Top="0.0" Width="100.0">
                    <LinearGradient Attribute="Fill" EndPoint="0.0,1.0" SpreadMethod="Pad">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#FFFFFF" Offset="0.2"/>
                        <GradientStop Color="#E0E0E9" Offset="1"/>
                    </LinearGradient>
                </Rectangle>
                <Text FontFamily="Arial" FontSize="12"
                    FontStyle="Normal" FontWeight="Normal"
                    HorizontalAlign="Left" Left="5.0" Name="Text"
                    Stroke="#404040" TextDecoration="None" Top="4.0">GlobalTooltip</Text>
                <Animate Animation="Stop" Attribute="Opacity"
                    CalcMode="Linear" Duration="0.4" Freeze="True"
                    From="1" Name="FadeOut" Repeat="1" To="0"/>
                <Animate Animation="Stop" Attribute="Opacity"
                    CalcMode="Linear" Duration="0.1" Freeze="True"
                    From="0" Name="FadeIn" Repeat="1" To="1"/>
            </Component>
        </Group>
        <Group Id="Module" Name="formulas">
            <Script Name="module" OnDocumentLoad="OnDocumentLoad"><![CDATA[var module_info = {
    name: "formulas",    
    version: "1.0.0-rc1",
    date: "2018-10-05",
    author: "Michel Jansson",
    dependencies: {}
};

var module = {
    module_info: module_info,
    
    sum: function(values) {
        var val = 0;
        for (var i in values)
            val += values[i];
        return val;
    },
    avg: function(values) {
        var val = this.sum(values);
        return val / Object.keys(values).length;
    },
    min: function(values) {
        var val = Infinity;
        for (var i in values)
            val = Math.min(values[i], val);
        return val;
    },
    max: function(values) {
        var val = -Infinity;
        for (var i in values)
            val = Math.max(values[i], val);
        return val;
    },
    getAggregateFunc: function(formula) {
        return formula.match(/sum|avg|min|max/i);
    },
    applyFormula: function(formula, values) {
        if (formula == null || values == null) return null;
        if (typeof values != "object") values = [values];   // Wrap in array if single value
        var val = values[0];    // Get a stat value
        formula = String(formula);
        var func = module.getAggregateFunc(formula);
        try {
            if (func) {
                var re = new RegExp(func);
                val = Number(eval(formula.replace(re,module[func](values))));
            }
            else
                val = Number(eval(formula.replace(/x/g,val)));
        } catch (ex) {
            val = values[0];
            alert(module_info.name+": Invalid formula: '" + formula + "'");
        }
        return val;
    }
};

function OnDocumentLoad(evt) { ModuleMaster.register(module, evt, null); }
]]></Script>
        </Group>
        <Group Id="Module"
            ModuleOptions="&quot;DefaultDecimals&quot;:&quot;1&quot;, &quot;AutoUnits&quot;:&quot;True&quot;" Name="value-formatter">
            <Script Name="module" OnDocumentLoad="OnDocumentLoad"><![CDATA[var module_info = {
    name: "value-formatter",    
    version: "1.0.0-rc2",
    date: "2018-10-05",
    author: "Michel Jansson",
    dependencies: {
        "helpers":"> 1.0.0-rc",
        "formulas":"> 1.0.0-rc"
    }
};

// Function thats is run after all modules has loaded
var tgml, lib, options, helpers, varStore, formulas;
function init(evt) {
    // Save some references
    tgml = view.document.getDocumentElement();
    lib = evt.getCurrentTarget();
    
    // Load modules
    helpers = ModuleMaster.require("helpers");
    varStore = helpers.varStore;
    formulas = ModuleMaster.require("formulas");
    
    // Read options
    try {
        options = JSON.parse("{"+lib.getAttribute("ModuleOptions")+"}");
    } catch(e) {
        alert("Invalid "+module_info.name+" options tag: wrong format\n'"+e.message+"'");
    }
    
    // Prevent default on all binds and links!
    helpers.setPreventDefault(tgml, true);
    // Setup global event listeners
    tgml.addEventListener("SignalChangeEvent", module.signal, true);
};

var module = {
    module_info: module_info,
    
    decimals: {
        // Overrides DefaultDecimals set in options if unit specific number is found below
        "%": 0,
        "% rh": 0,
        "ppm": 0,
        "w": 0,
        "wh": 0,
        "mwh": 3,
        "w/m2": 0,
        "hz": 0,
        "v": 0,
        "a": 0,
        "va": 0,
        "w": 0,
        "var": 0,
        "l": 0,
        "litre": 0,
        "l/min": 0,
        "l/h": 0,
        "l/s": 0,
        "m3/h": 0,
        "m3/s": 3,
        "lux": 0,
        "pa": 0,
        "km/h": 0,
        "year": 0,
        "month": 0,
        "week": 0,
        "day": 0,
        "h": 0,
        "min": 0,
        "s": 0
    },
    getDecimals: function(evt, unit) {
        // Get number decimals
        unit = unit || this.getUnit(evt);
        var decimals = evt.target.getAttribute("Decimals");
        if (decimals == "") decimals = this.decimals[unit.toLowerCase()];
        if (isNaN(decimals)) decimals = options.DefaultDecimals;
        return decimals;
    },
    getUnit: function(evt) {
            // Use unit from attribute if existing, else get unit from event if AutoUnits is set
            var unit = evt.target.getAttribute("Unit") != "" ? evt.target.getAttribute("Unit") : (String(options["AutoUnits"]).toLowerCase() == "true" && evt.unit != null ? evt.unit : "");
            if (unit.toLowerCase() == "nounit") unit = "";
            return unit;
    },
    getIsAnalog: function(evt) {
        if (evt.value !== null)
            return (evt.presentationValue != "" && !isNaN(String(evt.presentationValue).replace(/[,\s]/g,"").replace(/−/g,"-"))); // Replace comma and space (thousand separator) with nothing, weird dash (webstation uses this) with minus, so we dont get false negative.
        else
            return null;
    },
    signal: function(evt) {
        var bind = evt.target, bindParent = bind.parentNode;
        // Skip binds if prevented, has children or is handeled by others
        if (bind.getAttribute("PreventFormatter").toLowerCase() == "true") return;
        if (bind.hasChildNodes() && !(bind.childNodes.getLength() == 1 && bind.childNodes.item(0).tagName == "Expose")) return; // FIXME: Quite heavy fix for the occasional expose node
        if (!String(bind.getAttribute("Attribute")).match(/^Content$/)) return;
        if (String(bind.getAttribute("Name")).match(/AlarmState$|DisabledCause$|EvaluationState$/)) return;
        
        // Get / create store
        var store = varStore.getStore(bindParent);
        var valueObj = store["value-formatter"];
        if (!valueObj) {
            valueObj = store["value-formatter"] = new ValueObj(evt);
            // First run for this target, add click handler
            bindParent.addEventListener("MouseClickEvent", module.mouseHandler, false);
        }
        
        if (evt.status == 0) {
            // Set value to dashes, and clear filter if offline
            valueObj.value = "--";
            valueObj.filtValue = null;
        }
        else {
            valueObj.applyFormula(evt);        // Apply eventual formulas to value
        }
        valueObj.isForced = evt.status == 3;   // Save forced state
        valueObj.formatValue();                // Format and print the value
        
        // Start value filter if filter attribute exists on bindParent. Value is the Filter Time Constant.
        if (!valueObj.filter && bindParent.getAttribute("Filter") != "") {
            var tc = Number(bindParent.getAttribute("Filter"));
            if (isNaN(tc)) tc = 5;
            valueObj.filter = setInterval(function() {
                if(isNaN(valueObj.value)) return;
                if(typeof valueObj.filtValue == "undefined") valueObj.lastFilt = valueObj.filtValue = valueObj.value;
                // discrete time first order filter algorithm from menta FILT block
                valueObj.lastFilt = valueObj.filtValue = valueObj.lastFilt + (1/(1+(tc/1))) * (valueObj.value - valueObj.lastFilt);
                valueObj.formatValue();
            }, 1000);
        } else valueObj.filter = true;
        
        evt.preventDefault();   // Prevent red crosses on our carefully crafted values
    },
    mouseHandler: function(evt) {
        helpers.setPreventDefault(evt.currentTarget, false);    // Disable prevent default
        setTimeout(function(){ helpers.setPreventDefault(evt.currentTarget, true);}, 500); // Re-enable prevent default in 500ms
    }
};

function ValueObj(evt) {
    this.bindParent = evt.target.parentNode;
    this.unit = module.getUnit(evt);
    this.decimals = module.getDecimals(evt, this.unit);
    this.label = String(evt.target.parentNode.getAttribute("Label"));
    this.values = {};
    this.formattedValue = "";
}
    // Calc methods for easy access
    ValueObj.prototype = {
        isAnalog: function(evt) {
            if (typeof this._isAnalog != "undefined") // If already calculated, just return it
                return this._isAnalog;
            else if (evt.value !== null)    // If valid value, calculate if analog
                return this._isAnalog = module.getIsAnalog(evt);
            else
                return false;
        },
        formatValue: function() {
            var value, formattedValue;
            formattedValue = value = this.filtValue || this.value;
            // Format decimals
            if (this.isAnalog() && !isNaN(value) && !isNaN(this.decimals)) formattedValue = value.toFixed(Number(this.decimals));
            
            // Add unit if it exists
            if (this.unit != "") formattedValue = formattedValue + " "+ this.unit;
            
            // Add label if it exists on parent
            if (this.label != "") formattedValue = this.label + " " + formattedValue;
            
            // If the above yielded a format and is targeting the content of a text/textbox, set content automatically
            if (formattedValue != "" && this.bindParent.tagName.indexOf("Text") == 0) {
                // Set the formatted value
                this.bindParent.setAttribute("Content", formattedValue);    
                
                // Mark the eventual forced situation
                this.bindParent.setAttribute("Fill", this.isForced ? "#F68B1C" : "None");
                var tooltip = this.bindParent.getAttribute("Tooltip");
                if (tooltip != "") {
                    var pos = tooltip.indexOf(" >FORCERAD<");                  
                    if (pos > -1) tooltip = tooltip.substr(0,pos);
                    this.bindParent.setAttribute("Tooltip", tooltip + (this.isForced ? " >FORCERAD<" : ""));
                }
            }
            return this.formattedValue = formattedValue;
        },
        applyFormula: function(evt) {
            var bind = evt.target, bindName = String(bind.getAttribute("Name"));
            var value = evt.presentationValue;
            
            if (this.isAnalog(evt)) {
                value = Number(evt.value);
                
                // Try apply bind formula (only if no aggrigation action exists)
                var formula = String(bind.getAttribute("Formula"));
                if (formula != "" && !formulas.getAggregateFunc(formula))
                    value = formulas.applyFormula(formula, value);
                    
                // Save value to store
                this.values[bindName] = value;
                
                // Try apply aggregation formula
                var formula = String(this.bindParent.getAttribute("Formula")); // Applicera formula om det finns en
                if (formulas.getAggregateFunc(formula))
                    value = formulas.applyFormula(formula, this.values);
            }
            return this.value = value;
        }
    };

function OnDocumentLoad(evt) { ModuleMaster.register(module, evt, init); }
]]></Script>
        </Group>
        <Group Id="Module" Name="css">
            <Script Name="module" OnDocumentLoad="OnDocumentLoad"><![CDATA[var module_info = {
    name: "css",
    version: "1.0.0-rc2",
    date: "2018-10-08",
    author: "Michel Jansson, Mike Botens",
    dependencies: {}
};
// Flexbox based on code by Mike Botens.

// CONSTS
var VTYPES = {
    "bool": {type:"bool", "true":1, "false":1},
    "length": {type:"number", "":1, "px":1, "%":1, "vw":1, "vh":1},
    "auto": {type:"string", "auto":1},
    "pos": {type:"string", "":1, "absolute":1, "fixed":1, "sticky":1},
    "disp": {type:"string", "":1, "none":1, "block":1, "flex":1},
    "flexjust": {type:"string", "":1, "flex-start":1, "flex-end":1, "center":1, "space-between":1, "space-around":1, "space-evenly":1}
};
var VALIDATORS = {
    "width": [VTYPES.length, VTYPES.auto], "min-width": VTYPES.length, "max-width": VTYPES.length,
    "height": [VTYPES.length, VTYPES.auto], "min-height": VTYPES.length, "max-height": VTYPES.length,
    "margin-top": [VTYPES.length, VTYPES.auto], "margin-right": [VTYPES.length, VTYPES.auto], "margin-bottom": [VTYPES.length, VTYPES.auto], "margin-left": [VTYPES.length, VTYPES.auto],// "margin": VTYPES.lengthA,
    "font-size": VTYPES.length,
    "zoom": VTYPES.bool,
    "left": [VTYPES.length, VTYPES.auto], "right": [VTYPES.length, VTYPES.auto], "top": [VTYPES.length, VTYPES.auto],"bottom": [VTYPES.length, VTYPES.auto],
    "position": VTYPES.pos,
    "text-align": true,
    "display": VTYPES.disp,
    "flex-direction": {type:"string", "":1, "row":1, "column":1},
    "justify-content": VTYPES.flexjust,
    "align-content": VTYPES.flexjust,
    "align-items": VTYPES.flexjust,
    "flex-wrap": {type:"string", "":1, "nowrap":1, "wrap":1},
    "items-margin": VTYPES.length,
    "background-color": {type:"regex", regex:/^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$/},
    "translate-x": VTYPES.length, "translate-y": VTYPES.length
};
// Extra small devices (portrait phones, less than 576px)
// No media query since this is the default in Bootstrap
// Small devices (landscape phones, 576px and up)
// Medium devices (tablets, 768px and up)
// Large devices (desktops, 992px and up)
// Extra large devices (large desktops, 1200px and up)
var MEDIAS_OLD = {xs:0, s:567, m:768, l:992, xl:1200};
var MEDIAS = {"value": function(){return 1},
    "max-width": function(p){return view.width < Number(p)},
    "min-width": function(p){return view.width >= Number(p)},
    "max-height": function(p){return view.height < Number(p)},
    "min-height": function(p){return view.height >= Number(p)},
    "max-aspect-ration": function(p){return view.width/view.height < Number(p)},
    "min-aspect-ratio": function(p){return view.width/view.height >= Number(p)},
    "custom": function(p){return eval(p)}};

var setupDone = false;

// cssItem class
function CssItem(node) {
    this.node = node;
    this.left = this.lastLeft = this.initLeft = Number(this.node.getAttribute("Left"));
    this.top = this.lastTop = this.initTop = Number(this.node.getAttribute("Top"));
    this.width = this.lastWidth = this.initWidth = Number(this.node.getAttribute("Width"));
    this.height = this.lastHeight = this.initHeight = Number(this.node.getAttribute("Height"));
    this.effWidth = this.width; // Effective, may be a factored value for scale etc.
    this.effHeight = this.height;
    this.visibility = this.initVisibility = this.node.getAttribute("Visibility");
    
    this.scale = this.lastScale = 1, this.scaleCenter = [0,0], this.scaleNode = this.node.getChild("Css_Scale");
    this.translateX = this.lastTranslateX = this.translateY = this.lastTranslateY = 0, this.transNode = this.node.getChild("Css_Translate");
    
    this.bgNode = this.node.getChild("Css_Bg");
    
    this.container = {};
    this.container.node = function(){   // Self executing function
        var cont = node;
        if (cont.tagName != "Tgml")
            while (cont = cont.parentNode)
                if (cont.tagName == "Component" || cont.tagName == "Tgml")
                    break;
        return cont;
    }();
    this.container.width = 0;
    this.container.height = 0;
    this.updateContainerSize();
    
    this.styles = {};   // Will contain objects with names of MEDIAS, containing respective style
}
    CssItem.prototype = {
        updateContainerSize: function() {
            // Get container dimensions //
            if (this.container.node.tagName == "Tgml" && this.container.node.getAttribute("Stretch") != "None") {
                this.container.width = view.width / view.zoomLevel;
                this.container.height = view.height / view.zoomLevel;
            }
            else {
                this.container.width = Number(this.container.node.getAttribute("Width"));
                this.container.height = Number(this.container.node.getAttribute("Height"));
            }
        },
        getContentSize: function() {
            var list = this.node.getChildNodes();
            var height = 0;
            for (var i=0, n=list.getLength() ; i<n ; i++) {
                var c = list.item(i);
                if(c.getAttribute("Name") == "Css_Bg" || c.getAttribute("Visibility") != "Visible") continue; //Dont include css bg or hidden elements
                height = Math.max(Number(c.getAttribute("Top")) + Number(c.getAttribute("Height")) + ((c.hasAttribute("Margin-Bottom") ? Number(c.getAttribute("Margin-Bottom")) : 0)), height);
            }
            return height;
        },
        getCurrentStyle: function () {
            var style = {};
            for (var media in MEDIAS) {
                if (!this.styles[media]) continue;
                for (var size in this.styles[media]) {
                    if (MEDIAS[media](size)) {
                        for (var key in this.styles[media][size])
                            style[key] = this.styles[media][size][key];
                    }
                }
            }
            return style;
        },
        render: function() {
            if(this.left !== this.lastLeft)this.node.setAttribute("Left", this.lastLeft = this.left);
            if(this.top !== this.lastTop)this.node.setAttribute("Top", this.lastTop = this.top);
            
            // Bugfix for webstation at least 2.0.2.
            // Both width AND height needs to be changed for webstation to recognize it, fix by changing the other axis a tiny bit
            if(this.node.tagName == "Tgml") {
                if(this.width !== this.lastWidth && this.height === this.lastHeight) {
                    this.node.setAttribute("Height", this.height + this.width / 10000);
                }
                if(this.height !== this.lastHeight && this.width === this.lastWidth) {
                    this.node.setAttribute("Width", this.width + this.height / 10000);
                }
            }
            // End bugfix
            
            if(this.width !== this.lastWidth) {
                this.node.setAttribute("Width", this.lastWidth = this.width);
                if (this.node.tagName == "Component") this.node.setAttribute("ContentWidth", this.width);
            }
            if(this.height !== this.lastHeight) {
                this.node.setAttribute("Height", this.lastHeight = this.height);
                if (this.node.tagName == "Component") this.node.setAttribute("ContentHeight", this.height);
            }
            if(this.visibility !== this.lastVisibility) this.node.setAttribute("Visibility", this.lastVisibility = this.visibility);
            
            if (this.scale !== this.lastScale) {     // If scale is anything other than exactly one, some scaling is going on.    
                if (!this.scaleNode) {  // crate a scale node
                    this.scaleNode = this.node.appendChild(view.document.createElement("Scale"));
                    this.scaleNode.setAttribute("Name", "Css_Scale");
                }
                this.scaleNode.setAttribute("ScaleX", this.lastScale = this.scale);
                this.scaleNode.setAttribute("ScaleY", this.scale);
                this.scaleNode.setAttribute("Center", this.scaleCenter.join(","));
            }
            
            if (this.translateX !== this.lastTranslateX || this.translateY !== this.lastTranslateY) {
                if (!this.transNode) {  // crate a scale node
                    this.transNode = this.node.appendChild(view.document.createElement("Translate"));
                    this.transNode.setAttribute("Name", "Css_Translate");
                }
                this.transNode.setAttribute("X", this.lastTranslateX = this.translateX);
                this.transNode.setAttribute("Y", this.lastTranslateY = this.translateY);
            }
        }
    };

// Storage for all cssItems
var cssItems = [];

var module = {
    module_info: module_info,
    
    parseCssValue: function(prop, value) {
        var validators = VALIDATORS[prop.toLowerCase()];
        if(!validators) return {error:"unknown property '" +prop+ "'"};
        if (!(validators instanceof Array)) validators = [validators];     // If single obj, make into array so we can loop
        value = String(value).toLowerCase();
        // Loop thru array of validators to see if any matches
        for (var i in validators) {
            var validator = validators[i];
            if (validator.type == "number") {
                var res = /^([-+]?[0-9]*\.?[0-9]+)(\D*)$/.exec(value);
                if (!res) continue;
                if (!validator[res[2]]) return {error:"unknown unit for '" +prop+ "'"};
                return {value: Number(res[1]), unit: res[2]};
            }
            else if (validator.type == "string") {
                if (!validator[value]) continue; 
                return {value: value, unit: ""};
            }
            else if (validator.type == "bool") {
                if (!validator[value]) continue; 
                return {value: (value == "true" ? true : false), unit: ""};
            }
            else if (validator.type == "regex") {
                if (!validator.regex.test(value)) continue; 
                return {value: value, unit: ""};
            }
            else    // None of out know types matched, scream!
                return {error:"unknown validator '" +validator.type+ "'"};
        }
        // We had good validators, but got no match anyway, scream!
        return {error:"invalid data for '" +prop+ "'"};
    },
    
    parseCssJson: function(jsonString, nodeName) {
        var style = {};
        // Style attributes formatted as JSON, get styles
        try {
            var json = JSON.parse(jsonString);
        } catch(e) {
            throw "Invalid css tag: wrong format\n'"+e.message+"' in node '"+nodeName+"'";
        }
        for (var key in json) {
            var valueObj = this.parseCssValue(key, json[key]);
            key = key.toLowerCase();
            if (valueObj.error)
                throw "Invalid css tag: " +valueObj.error+ " in node '"+nodeName+"'";
            else
                style[key] = valueObj;
        }
        return style;
    },
    
    setAttribute: function(node, attr, value, media, resize) {
        media = media || "value_0";
        var cssItem = this.getCssItem(node);
        if (cssItem) {
            var valueObj = this.parseCssValue(attr, value);
            if (valueObj.error) return "Invalid css tag: " +valueObj.error+ " in node '"+cssItem.node.getAttribute("Name")+"'";
            
            media = media.toLowerCase().split("_");
            if (cssItem.styles[media[0]] == null)
                console.log("Media '"+ media + " does not exist on target, no new medias can be defined with this function.");
            else if (cssItem.styles[media[0]][media[1]] == null)
                console.log("Media size'"+ media + " does not exist on target, no new medias can be defined with this function.");
            else
                cssItem.styles[media[0]][media[1]][attr.toLowerCase()] = valueObj;
            
            if(resize) this.resize(cssItem);
        }
    },
    
    getAttribute: function(node, attr, media) {
        var cssItem = this.getCssItem(node);
        if (cssItem) return cssItem.styles[(media || "xs")][attr].value;
    },
    
    getCssItem: function(node) {
        for (var i in cssItems)
            if (cssItems[i].node.isSameNode(node)) return cssItems[i];
    },
    
    setup: function(node, doResize, recursive) {
        if(!node) {
            if (cssItems.length !== 0) return;  // If already setup, dont do it again...
            //console.log("Css: Fresh setup");
            node = view.document.getDocumentElement();
        }
        //console.log("Css: Node setup");
        
        // Make sure the meta-tag is the first child of the affected node (for proccess ordering)
        var metaList = node.getElementsByTagName("Metadata");
        for (var i=0, n=metaList.getLength() ; i<n ; i++) {
            var meta = metaList.item(i);
            if (meta.getAttribute("Name") != "Css") continue;
            var parent = meta.getParentNode();
            parent.insertBefore(meta, parent.getFirstChild());
        }
        
        // Find and get responsive nodes
        var metaList = node.getElementsByTagName("Metadata");
        for (var i=0, n=metaList.getLength() ; i<n ; i++) {
            var meta = metaList.item(i);
            if (meta.getAttribute("Name") != "Css" || meta.hasAttribute("Disabled")) continue;
            
            // Try get existing cssItem
            var cssItem = this.getCssItem(meta.parentNode);
            if(!cssItem) {  // Create cssItem
                cssItem = new CssItem(meta.parentNode);
                cssItems.push(cssItem);
            };
            
            // Get Css data
            var tmpStyles = {};
            for (var j=0; j < meta.attributes.length; j++) {
                var attr = meta.attributes.item(j);
                var style;
                if (attr.name == "Name") continue;
                else if (attr.name == "Media_custom") {
                    style = this.parseCssJson(attr.value.substring(attr.value.indexOf("{")));
                    var condition = String(attr.value.substring(0, attr.value.indexOf("{")))
                        .replace(/\(([a-z-]+?):(\d+)\)/g, "(MEDIAS[\"\$1\"](\$2))")
                        .replace("and", "&&")
                        .replace(",", "||");
                    cssItem.styles["custom"] = {};
                    cssItem.styles["custom"][condition] = style;
                }
                else {
                    style = this.parseCssJson("{"+attr.value+"}", cssItem.node.getAttribute("Name"));
                    var attrName = attr.name.split("_");
                    if (attrName[0] == "Value") attrName = ["Media", "value", "0"];
                    if (attrName[0] == "Media") {
                        // Temporary legacy support
                        if (attrName[1] == "xl" || attrName[1] == "l" || attrName[1] == "m" || attrName[1] == "s") {
                            attrName = ["Media", "min-width", MEDIAS_OLD[attrName[1]]];
                        }
                        if (MEDIAS[attrName[1]] && !isNaN(attrName[2])) {
                            if (!tmpStyles[attrName[1]]) tmpStyles[attrName[1]] = {}; 
                            tmpStyles[attrName[1]][attrName[2]] = style;
                        }
                        else
                            console.log("unknown media '"+attrName[1]+"'");
                    }
                }
                if (style["display"] && style["display"].value == "flex") cssItem.isFlexContainer = true;   // find flexboxes as they are initiaded separatly
            }
            
            // Polish styles and save to item
            for (var media in tmpStyles) {
                if (media == "custom") continue;
                Object.keys(tmpStyles[media]).sort(function(a,b){return Number(a)-Number(b)}).forEach(function(key) {   // result form above loop has undefined order, we need number order (small to large size)
                    if (!cssItem.styles[media]) cssItem.styles[media] = {}; 
                    cssItem.styles[media][key] = tmpStyles[media][key];
                });
            }
        }
        
        for (var i in cssItems)
            if (cssItems[i].isFlexContainer) cssItems[i].flexbox = new FlexBox(cssItems[i]);
        
        //console.log("Css: Setup finished");
        if(node && doResize)
            this.resize();
    },
    
    resize: function(cssItem) {
        if (typeof cssItem === "object") module.renderItems([cssItem]);
        else module.renderItems(cssItems);
    },

    renderItems: function(items, pass2) {
        if (view.zoomLevel == 0) {
            //console.log("Resize skipped due invalid zoomLevel");
            return;
        }
        
        // Get TGML dimensions and panposition
        var scrollX = 0, scrollY = 0;
        if (view.scrollLeft) {
            scrollX = view.scrollLeft / view.zoomLevel;
            scrollY = view.scrollTop / view.zoomLevel;
        }
        
        var itemsPass2 = [], itemsFlex = [];
    
        for (var i in items) {
            var cssItem = items[i];
            cssItem.updateContainerSize();
            var style = cssItem.getCurrentStyle();
            var addToPass2 = false;
            
            // Zoom - Scale Calc //
            if (style["zoom"]) {
                if (!style["zoom"].value)
                    cssItem.scale = 1 / view.zoomLevel;
                else
                    cssItem.scale = 1;
            }
            
            // Calculate primitive margins //
            var margins = {"margin-top":null, "margin-right":null, "margin-bottom":null, "margin-left":null};
            for (var key in margins) {
                if (style[key]) {
                    if (style[key].value == "")
                        continue;
                    else if (style[key].value == "auto") {
                        margins[key] = 0;
                        margins[key+"-auto"] = true;
                        continue;
                    }
                    var actValue = getTgmlPt(cssItem, style, key);
                    if (actValue != null)
                        margins[key] = actValue;
                }
            }
            
            // Calc width //
            var keys = {"width":1, "min-width":1, "max-width":1};
            for (var key in keys) {
                if (style[key]) {
                    if(style[key].value == "auto") { // Fill rest of availble space
                        cssItem.width = cssItem.container.width - margins["margin-left"] - margins["margin-right"];
                    }
                    else {
                        var actValue = getTgmlPt(cssItem, style, key);
                        if (actValue != null && !(key.indexOf("min") == 0 && actValue < cssItem.width) && !(key.indexOf("max") == 0 && actValue > cssItem.width)) // Set size, do not set max-size if within limits
                            cssItem.width = (style[key].unit == "" ? actValue : actValue / cssItem.scale); // Only remove factor if size not relative to tgml
                    }
                }
            }
            
            // Calc height //
            var keys = {"height":1, "min-height":1, "max-height":1};
            for (var key in keys) {
                if (style[key]) {
                    if(style[key].value == "auto") {
                        if(pass2) cssItem.height = cssItem.getContentSize();
                        else addToPass2 = true;
                    }
                    else {
                        var actValue = getTgmlPt(cssItem, style, key);
                        if (actValue != null && !(key.indexOf("min") == 0 && actValue < cssItem.height) && !(key.indexOf("max") == 0 && actValue > cssItem.height)) {  // Set size, do not set max-size if within limits
                            cssItem.height = (style[key].unit == "" ? actValue : actValue / cssItem.scale); // Only remove factor if size not relative to tgml
                        }
                    }
                }
            }
            
            // Display //
            var key = "display";
            if (style[key] && !pass2) {     // Dont calc all this, (flexboxes) again if height was set to auto
                switch (style[key].value) {    // Switch value
                    case "none":
                        cssItem.visibility = "Hidden";
                        break;
                    case "block":
                        cssItem.visibility = "Visible";
                        break;
                    case "flex":
                        if (cssItem.flexbox)
                            itemsFlex.push(cssItem)
                    default:
                        break;
                }
            }
            
            // Calc effective size // - this must be after flexbox, since it modifies size of the cssItem if set to auto
            cssItem.effWidth = cssItem.width * cssItem.scale;
            cssItem.effHeight = cssItem.height * cssItem.scale;
            
            // Set text-align
            var textAlign = null, textValign = null;
            
            // Calculate auto margins //
            // If pair is auto, calculate to center                          v-This weird bit equals !(left XOR right)-v
            if (margins["margin-left-auto"] && margins["margin-right-auto"] && !(!style["left"] != !style["right"])) {
                margins["margin-left"] = margins["margin-right"] = cssItem.container.width/2 - cssItem.effWidth/2;
                cssItem.scaleCenter[0] = 0,5;   // Set scaling to occur from center
                textAlign = "Center";
            }                                                              // v-This bit equals !(top XOR bottom)-v        
            if (margins["margin-top-auto"] && margins["margin-bottom-auto"] && !(!style["top"] != !style["bottom"]) && style["height"].value != "auto") {
                margins["margin-top"] = margins["margin-bottom"] = cssItem.container.height/2 - cssItem.effHeight/2;
                cssItem.scaleCenter[1] = 0,5;   // Set scaling to occur from middle
                textValign = "Middle";
            }
            if(margins["margin-bottom"] !== null)
                cssItem.node.setAttribute("Margin-Bottom", margins["margin-bottom"]);  // Save margin so cssItem.getContentSize can include the margins
            
            // Calculate final position //
            if (!cssItem.isFlexItem) {
                var left = null, top = null;
                if((style["left"] && style["left"].value != "auto") || (style["margin-left"] && !style["right"])) {
                    left = getTgmlPt(cssItem, style, "left");
                    left += margins["margin-left"];
                    
                    if (!textAlign) textAlign = "Left";
                }
                else if(style["right"]) {
                    left = cssItem.container.width - cssItem.effWidth;
                    left -= margins["margin-right"];
                    left -= getTgmlPt(cssItem, style, "right");
                    
                    if (!textAlign) textAlign = "Right";
                }
                
                if((style["top"] && style["top"].value != "auto") || (style["margin-top"] && !style["bottom"])) {
                    top = getTgmlPt(cssItem, style, "top");
                    top += margins["margin-top"];
                    
                    if (!textValign) textValign = "Top";
                }
                else if(style["bottom"]) {
                    top = cssItem.container.height - cssItem.effHeight;
                    top -= margins["margin-bottom"];
                    top -= getTgmlPt(cssItem, style, "bottom");
                    if (!textValign) textValign = "Bottom";
                }
                if (style["position"]) {
                    // Just add scroll to get fixed
                    if (style["position"].value == "fixed") {
                        if(left !== null) left += scrollX;
                        if(top !== null) top += scrollY;
                    }
                    else if (style["position"].value == "sticky") {
                        if(style["left"] || style["right"]) {
                            left = left || getTgmlPt(cssItem, style, "left") || getTgmlPt(cssItem, style, "right");
                            var maxLeft = (view.width/view.zoomLevel) - cssItem.effWidth - margins["margin-right"] + scrollX;
                            if (left > maxLeft) left = maxLeft;
                            var minLeft = margins["margin-left"] + scrollX;
                            if (left < minLeft) left = minLeft;
                        }
                        if(style["top"] || style["bottom"]) {
                            top = top || getTgmlPt(cssItem, style, "top") || getTgmlPt(cssItem, style, "bottom");
                            var maxTop = (view.height/view.zoomLevel) - cssItem.effHeight - margins["margin-bottom"] + scrollY;
                            if (top > maxTop) top = maxTop;
                            var minTop = margins["margin-top"] + scrollY;
                            if (top < minTop) top = minTop;
                        }
                    }
                }
                if (left !== null) cssItem.left = left;
                if (top !== null) cssItem.top = top;
                
                // If both left/right or top/bottom is set, and no width or height specefied, autocalc width/height
                if ((style["left"] && style["left"].value != "auto") &&
                    (style["right"] && style["right"].value != "auto") &&
                    !(style["width"] && style["width"].value != "auto")) {
                    cssItem.width = cssItem.container.width - left - margins["margin-right"] - getTgmlPt(cssItem, style, "right");
                }
                if ((style["top"] && style["top"].value != "auto") &&
                    (style["bottom"] && style["bottom"].value != "auto") &&
                    !(style["height"] && style["height"].value != "auto")) {
                    cssItem.height = cssItem.container.height - top - margins["margin-bottom"] - getTgmlPt(cssItem, style, "bottom");
                    addToPass2 = false; // No need to run pass2 for height, since we aldready fixed it!
                }
            }
            
            // Set text aligns if any was calculated //
            if (cssItem.node.tagName == "Text") {
                if (textAlign) cssItem.node.setAttribute("HorizontalAlign", textAlign);
                if (textValign) cssItem.node.setAttribute("VerticalAlign", textValign);
            }
            
            // Set fontsize
            var key = "font-size";
            if (style[key]) {
                var actValue = getTgmlPt(cssItem, style, key);
                if (actValue != null)
                    cssItem.node.setAttribute("FontSize", actValue);
            }
            
            // Background //
            if (cssItem.bgNode || style["background-color"]) {
                if (!cssItem.bgNode) {  // crate a scale node
                    cssItem.bgNode = cssItem.node.insertBefore(view.document.createElement("Rectangle"), cssItem.node.getChild("Css"));
                    cssItem.bgNode.setAttribute("Name", "Css_Bg");
                    cssItem.bgNode.setAttribute("StrokeWidth", 0);
                    cssItem.bgNode.setAttribute("Stroke", "None");
                }
                if (style["background-color"])
                    cssItem.bgNode.setAttribute("Fill", style["background-color"].value);
                cssItem.bgNode.setAttribute("Width", cssItem.width);
                cssItem.bgNode.setAttribute("Height", cssItem.height);
            }
            
            // Translate //
            if (style["translate-x"])
                cssItem.translateX = getTgmlPt(cssItem, style, "translate-x");
            if (style["translate-y"])
                cssItem.translateY = getTgmlPt(cssItem, style, "translate-y");
            
            // Add second pass
            if(addToPass2) itemsPass2.push(cssItem);
            
            // Render it
            cssItem.render();
        }
        if (itemsFlex.length > 0 && !pass2) {
            for (var i in itemsFlex.reverse()) itemsFlex[i].flexbox.resize();
        }
        if (itemsPass2.length > 0 && !pass2)
            this.renderItems(itemsPass2.reverse(), true);
    }
};

function FlexBox(cssItem) {
    this.container = cssItem;
    this.items = [];
    this.rowcols = [];
    
    // Init 
    var children = cssItem.node.getChildNodes();
    for(var i=0, n=children.getLength() ; i<n ; i++) {
        var c = children.item(i);
        if(c.tagName != "Component") continue;
        
        var flexItem = module.getCssItem(c);
        if (!flexItem) {
            flexItem = new CssItem(c);
            cssItems.push(flexItem);
        }
        flexItem.isFlexItem = true;
        flexItem.flexContainer = this;
        
        // We need "real" margins on the items for everything to work property.
        // convert items-margin to stanrdard margins on the items itself
        for (var media in this.container.styles) {
            //let lastStyle;
            for (var size in this.container.styles[media]) {
                let style = flexItem.styles[media] ? flexItem.styles[media][size] : null;
                if (this.container.styles[media][size].hasOwnProperty("items-margin")) {
                    if (style == null) {
                        if (flexItem.styles[media] == null) flexItem.styles[media] = {};                 
                        flexItem.styles[media][size] = style = {};
                    }
                    style["margin-top"] = this.container.styles[media][size]["items-margin"];
                    style["margin-right"] = this.container.styles[media][size]["items-margin"];
                    style["margin-bottom"] = this.container.styles[media][size]["items-margin"];
                    style["margin-left"] = this.container.styles[media][size]["items-margin"];
                }
            }
        }
        this.items.push(flexItem);
    }
}
FlexBox.prototype = {
    resize: function() {
        var style = this.container.getCurrentStyle();
        this.flexDirection = style["flex-direction"] ? style["flex-direction"].value : "row";
        this.flexWrap = style["flex-wrap"] ? style["flex-wrap"].value : "wrap";
        this.justifyContent = style["justify-content"] ? style["justify-content"].value : "";
        if (style["height"] && style["height"].value == "auto") {
            if (this.flexDirection == "column")
                this.justifyContent = "flex-start";
            else
                this.alignContent = "flex-start";
        }
        else
            this.alignContent = style["align-content"] ? style["align-content"].value : "";
        this.alignItems = style["align-items"] ? style["align-items"].value : "";
        
        this.itemsMargin = style["items-margin"] ? style["items-margin"].value : 0;
        
        // set sizes and pos vars for below calcs depending if row or col
        if (this.flexDirection == "column")
            this.size1 = "height", this.size2 = "width", this.pos1 = "top", this.pos2 = "left";
        else
            this.size1 = "width", this.size2 = "height", this.pos1 = "left", this.pos2 = "top";
        
        this.orderItems();
        this.calcRowcols();
        this.setMainAxis();
        this.setCrossAxis();
        if (this.flexDirection == "row") this.container.height = this.contentSize2;
        if (this.flexDirection == "column") this.container.height = this.contentSize1;
        this.render();
        
    },
    orderItems: function() {
        for (var i=0 ; i<this.items.length ; i++) {
            var item = this.items[i];
            if (item.node.hasAttribute("flex-order"))
                item.order = Number(item.node.getAttribute("flex-order"));
            else
                item.order = 10000+i;
        }
        this.items.sort(function(a, b) {
            return a.order - b.order;
        });
    },
    calcRowcols: function() {   // Calculate the number of rows (if direction is row) or columns (if direction column), populate each with items, and cacls its size
        var rowcol = 0;
        this.rowcols = [];
        this.rowcols[rowcol] = {items:[], width: 0, height: 0};
        var currSize1 = 0, totSize2 = 0, totSize1 = 0;
        for (var i in this.items) {
            var item = this.items[i];
            if (item.node.getAttribute("Visibility") == "Hidden") continue;
            // add new item size
            currSize1 += item[this.size1];
            currSize1 += this.itemsMargin*2;

            // if row/col too big create new if wrap is enabled
            if(currSize1 > this.container[this.size1] && this.rowcols[rowcol].items.length > 0 && this.flexWrap == "wrap") {
                totSize2 += this.rowcols[rowcol][this.size2];
                totSize1 += this.rowcols[rowcol][this.size1];
                rowcol++;
                // Init new row/col
                this.rowcols[rowcol] = {items:[], width: 0, height: 0};
                currSize1 = item[this.size1];
                currSize1 += this.itemsMargin*2;
            }
            // update current row/col
            this.rowcols[rowcol].items.push(item);
            this.rowcols[rowcol][this.size1] = currSize1;
            this.rowcols[rowcol][this.size2] = Math.max(item[this.size2] + this.itemsMargin*2, this.rowcols[rowcol][this.size2]);
        }
        // Save main axis size
        this.contentSize1 = totSize1 + this.rowcols[rowcol][this.size1];
        // save the crossaxis size
        this.contentSize2 = totSize2 + this.rowcols[rowcol][this.size2];
        
    },
    setMainAxis: function() {   // This sets lefts if flow direction is row, or sets tops if direction is column
        for(var rowcol in this.rowcols) {
            var currPos1 = this.itemsMargin;
            var margin = this.itemsMargin*2;
            
            var whiteSpace = this.container[this.size1] - this.rowcols[rowcol][this.size1];
            switch(this.justifyContent) {
                case "flex-start":
                    break;
                case "flex-end":
                    currPos1 += whiteSpace;
                    break;        
                case "space-between":
                    margin += Math.max(0, whiteSpace / (this.rowcols[rowcol].items.length - 1));
                    break;
                case "space-around":        
                    currPos1 += Math.max(0, whiteSpace / (this.rowcols[rowcol].items.length * 2));
                    margin = currPos1 * 2;
                    break;
                case "space-evenly":
                    currPos1 += Math.max(0, whiteSpace / (this.rowcols[rowcol].items.length + 1));
                    margin = currPos1 + this.itemsMargin;
                    break;
                case "center":
                default:
                    currPos1 += whiteSpace / 2;
            }
            
            for(var i in this.rowcols[rowcol].items) {
                this.rowcols[rowcol].items[i][this.pos1] = currPos1;
                currPos1 += this.rowcols[rowcol].items[i][this.size1];
                currPos1 += margin;
            }   
        }
    },
    setCrossAxis: function() {  // This sets tops if flow direction is row, or sets lefts if direction is column
        var rowcolPos2 = 0, rowcolMargin = 0;
        var whiteSpace = this.container[this.size2] - this.contentSize2;
        switch(this.alignContent) {
            case "flex-start":
                break;
            case "flex-end":
                rowcolPos2 = whiteSpace;
                break;        
            case "space-between":
                rowcolMargin = Math.max(0, whiteSpace / (this.rowcols.length - 1));
                break;
            case "space-around":     
                rowcolPos2 = Math.max(0, whiteSpace / (this.rowcols.length * 2));
                rowcolMargin = rowcolPos2 * 2;
                break;
            case "space-evenly":
                rowcolPos2 = Math.max(0, whiteSpace / (this.rowcols.length + 1));
                rowcolMargin = rowcolPos2 + this.itemsMargin;
                break;
            case "center":
            default:
                rowcolPos2 = whiteSpace / 2;
        }
        
        for(var rowcol in this.rowcols) {
            for(var i in this.rowcols[rowcol].items) {
                var currPos2 = this.itemsMargin;
                var whiteSpace = this.rowcols[rowcol][this.size2] - this.rowcols[rowcol].items[i][this.size2] - this.itemsMargin*2;
                switch(this.alignItems) {
                    case "flex-start":
                        break; 
                    case "flex-end":
                        currPos2 += whiteSpace;
                        break;        
                    case "center":
                        currPos2 += whiteSpace / 2;
                        break;
                    //case "stretch":
                    //    this.rows[row].items[i].height = this.rows[row].height;     
                    //    break;
                    default:
                        break;
                }
                this.rowcols[rowcol].items[i][this.pos2] = rowcolPos2 + currPos2;
            }
            rowcolPos2 += this.rowcols[rowcol][this.size2];
            rowcolPos2 += rowcolMargin;
        }
    },
    render: function() {
        for (var i in this.items) {
            this.items[i].render();
            this.items[i].node.setAttribute("Margin-Bottom", this.itemsMargin);  // Save margin so cssItem.getContentSize can include the margins
        }
    }
}

function getTgmlPt (cssItem, style, key) {
    if(!style[key]) return 0;
    var actValue, reqValue = style[key].value;
    if (reqValue == "auto") return 0;
    if (cssItem.node.tagName == "Tgml" && style[key].unit == "px") style[key].unit = "";    // Tgml node cant handle px values, we end up in an infinite zoomloop.
    switch (style[key].unit) {    // Switch on unit
        case "%":
            if(key == "width" || key.indexOf("left") > -1 || key.indexOf("right") > -1) actValue = (reqValue/100) * cssItem.container.width;
            else if(key == "height" || key.indexOf("top") > -1 || key.indexOf("bottom") > -1) actValue = (reqValue/100) * cssItem.container.height;
            else if(key == "translate-x") actValue = (reqValue/100) * cssItem.width;
            else if(key == "translate-y") actValue = (reqValue/100) * cssItem.height;
            break;
        case "vw":
            actValue = (reqValue/100) * view.width;
            break;
        case "vh":
            actValue = (reqValue/100) * view.height;
            break;
        case "px":
            actValue = reqValue / view.zoomLevel;
            break;
        default:
            actValue = reqValue;
            break;
    }
    return actValue;
}

// Setup this module
module.setup();
module.resize();    // Run resize in case the browser doesnt
view.addEventListener('resize', function() { module.resize(); }); // Start listening for resize events 

function OnDocumentLoad(evt) { ModuleMaster.register(module, evt); }]]></Script>
        </Group>
        <Group Id="Module" Name="curve">
            <Script Name="module" OnDocumentLoad="OnDocumentLoad"><![CDATA[var module_info = {
    name: "curve",
    version: "1.0.0-rc1",
    date: "2018-10-04",
    author: "Michel Jansson",
    dependencies: {
        "helpers": "> 1.0.0-rc",
        "tooltip": ">= 2.4.0",
        "value-formatter": "> 1.0.0-rc"
    }
};

// Function thats is run after all modules has loaded
var helpers, tooltip, tgml, lib;
function init(evt) {
    // Load external modules
    helpers = ModuleMaster.require("helpers");
    tooltip = ModuleMaster.require("tooltip");
    
    // Save some references
    tgml = view.document.getDocumentElement();
    lib = evt.getCurrentTarget();
};

var module = {
    module_info: module_info,
    
    setup: function(node) {
        var curveObj = new Curve(node);
        
        // Create points
        var binds = node.getChild("Binds").getElementsByTagName("Bind");
        for (var i=0; i < binds.getLength(); i++) {
            let bind = binds.item(i);
            let bindId = bind.getAttribute("Id");
            
            // If bind Id starts with X or Y, assume break point bind
            if (bindId.indexOf("X") == 0 || bindId.indexOf("Y") == 0) {     
                var bpNum = Number(bindId.substr(1,1));     // Get bind break point number
                if (isNaN(bpNum)) continue;
                
                let bp = curveObj.bps[bpNum];
                if (!bp) {
                    // If the break point does not exist in the curve, create one from the template
                    bp = curveObj.bps[bpNum] = new Point(curveObj, lib.getChild("PointHandle").cloneNode(true), bpNum, "Point");
                    curveObj.ws.appendChild(bp.node);   // Add to worksapce
                    // Attach moveBp eventhandlers
                    bp.node.addEventListener("MouseDownEvent", function(evt){module.moveBp(evt, bp)}, false);
                    bp.node.addEventListener("MouseMoveEvent", function(evt){module.moveBp(evt, bp)}, false);
                    bp.node.addEventListener("MouseUpEvent", function(evt){module.moveBp(evt, bp)}, false);
                    bp.node.addEventListener("MouseOutEvent", function(evt){module.moveBp(evt, bp)}, false);
                }
                let tableBp = curveObj.tableBps[bpNum];
                if (!tableBp) {
                    // If the break point does not exist in the table, create one from the template
                    tableBp = curveObj.tableBps[bpNum] = new Point(curveObj, lib.getChild("TableRow").cloneNode(true), bpNum, "TableRow");
                    tableBp.node.setAttribute("Name", "");  // Remove name so named binds can be moves here
                    tableBp.node.getChild("Label").setAttribute("Content", "Brytpunkt "+bpNum);
                    tableBp.node.setAttribute("Top", Number(tableBp.node.getAttribute("Top"))+((bpNum-1)*24));
                    curveObj.table.appendChild(tableBp.node);
                    // Attach bindhandeler that will show row
                    tableBp.node.addEventListener("SignalChangeEvent", function(evt){tableBp.show()}, false);
                }

                if(bindId.indexOf("X") == 0) {
                    bp.xBind = bind;
                    bind.addEventListener("SignalChangeEvent", function(evt){module.signalBp(evt,bp,"X")}, false);
                    // Clone bind to table get get value-formatter functionality
                    let newbind = tableBp.node.getChild("X").appendChild(document.createElement("Bind"));
                    newbind.setAttribute("Name", bind.getAttribute("Name"));
                    newbind.setAttribute("Attribute", "Content");
                    newbind.setAttribute("PreventDefault", "True");
                }
                else {
                    bp.yBind = bind;
                    bind.addEventListener("SignalChangeEvent", function(evt){module.signalBp(evt,bp,"Y")}, false);
                    // Clone bind to table get get value-formatter functionality
                    let newbind = tableBp.node.getChild("Y").appendChild(document.createElement("Bind"));
                    newbind.setAttribute("Name", bind.getAttribute("Name"));
                    newbind.setAttribute("Attribute", "Content");
                    newbind.setAttribute("PreventDefault", "True");
                }
            }
            else if (bindId == "CurrentY") {
                // Clone bind to table get get value-formatter functionality
                let newbind = curveObj.table.getChild("Result").getChild("Value").appendChild(document.createElement("Bind"));
                newbind.setAttribute("Name", bind.getAttribute("Name"));
                newbind.setAttribute("Attribute", "Content");
                newbind.setAttribute("PreventDefault", "True");
                curveObj.table.getChild("Result").setAttribute("Name", "");
            }
        }
        
        // Add eventlisteners
        node.getChild("Binds").addEventListener("SignalChangeEvent", function(evt){module.update(evt,curveObj)}, false);
        node.getChild("Toolbar").getChild("Save").addEventListener("MouseClickEvent", function(evt){module.save(curveObj)}, false);
        node.getChild("Toolbar").getChild("Revert").addEventListener("MouseClickEvent", function(evt){module.revert(curveObj)}, false);
        
        // Activate all bind
        setTimeout(function(){helpers.enableBinds(node)}, 1);
    },
    signalBp: function(evt, bp, xy) {
        var value = Number(evt.getValue());
        if (xy == "X") {    // If bind is a X value, update X parts
            bp.x = value;   // Store the actual value
            bp.node.setAttribute("Left", bp.xPosOld = bp.xPos = bp.curveObj.getPxLeft(value));
        }
        else if (xy == "Y") {   // If bind is a Y value, update Y parts
            bp.y = value;   // Store the actual value
            bp.node.setAttribute("Top", bp.yPosOld = bp.yPos = bp.curveObj.getPxTop(value));
        }
        
        bp.show();  // Show it
        
        // Set tooltip
        bp.node.setAttribute("Tooltip", "X"+bp.bpNum+": " + bp.x.toFixed(bp.curveObj.decimalsX) + "\nY"+bp.bpNum+": " + bp.y.toFixed(bp.curveObj.decimalsY));
        // Update polyline
        this._drawPolyline(bp.curveObj.ws, bp.curveObj.bps, false);
    },
    update: function(evt, curveObj) {
        /* Function that is triggered by bindings */
        var bindId = String(evt.getTarget().getAttribute("Id"));
        var value = Number(evt.getValue());
        var pxLeft = curveObj.getPxLeft(value);
        var pxTop = curveObj.getPxTop(value);
        
        if (bindId == "CurrentX") {
            curveObj.currentXNode.setAttribute("Left", pxLeft + curveObj.wsLeft); // We need to add wsLeft to pxvalue, since this is outside the ws
            curveObj.currentXNode.getChild("Label").setAttribute("Content", value.toFixed(curveObj.decimalsX));
        }
        else if (bindId == "CurrentY") {
            curveObj.currentY = value;
            curveObj.currentYNode.setAttribute("Top", pxTop + curveObj.wsTop);
            curveObj.currentYNode.getChild("Label").setAttribute("Content", value.toFixed(curveObj.decimalsY));
        }
        else if (bindId == "CurveLimit") {
            curveObj.ws.setAttribute("CurveLimit", value);
            // Update polyline
            this._drawPolyline(curveObj.ws, curveObj.bps, false);
        }
    },
    moveBp: function(evt, bp) {
        /* Function that is triggerd by mouse events on break points */
        if (bp == null) return;
        var curveObj = bp.curveObj;
        
        if (evt.getType() == "MouseDownEvent") {  // If Mouse down
            evt.preventDefault();
            curveObj.drag = true;  // Enable drag
            
            // Lazyly get step size
            if(isNaN(curveObj.step))
                curveObj.step = Number(curveObj.node.getChild("Step").getAttribute("Value").replace(",","."));
            
            // Configure tooltip to be snappy and follow mouse
            if (!tooltip.defaults) { // Save defaults
                tooltip.defaults = {
                    followCursor: tooltip.followCursor,
                    enableDelay: tooltip.enableDelay,
                    disableDelay: tooltip.disableDelay
                }; 
            }
            tooltip.disable();
            tooltip.followCursor = true;
            tooltip.enableDelay = 1;
            tooltip.disableDelay = 30000;
            tooltip.over(evt);
            return;
        }
        if ((evt.getType() == "MouseUpEvent" || evt.getType() == "MouseOutEvent") && curveObj.drag) {  // If mouse up and drag is enabled
            curveObj.drag = false; // Disable drag
            
            // Check anything to save
            if (!isNaN(bp.newX) || !isNaN(bp.newY)) {
                // Light up buttons
                curveObj.node.getChild("Toolbar").getChild("Save").setAttribute("Visibility", "Visible");
                curveObj.node.getChild("Toolbar").getChild("Revert").setAttribute("Visibility", "Visible");
            }
            else
                this.revert(evt);
            
            // Restore tooltip configuration
            tooltip.disable();
            tooltip.followCursor = tooltip.defaults.followCursor;
            tooltip.enableDelay = tooltip.defaults.enableDelay;
            tooltip.disableDelay = tooltip.defaults.disableDelay;
            return;
        }
        if (evt.getType() != "MouseMoveEvent" || !curveObj.drag) {
            return;
        }
        
        // Get mouse pos
        var xPos = evt.getCurrentTargetParentX();
        var yPos = evt.getCurrentTargetParentY();       
        // Limit within workspace
        if (xPos < 0) xPos = 0;
        if (xPos > curveObj.wsWidth) xPos = curveObj.wsWidth;
        if (yPos < 0) yPos = 0;
        if (yPos > curveObj.wsHeight) yPos = curveObj.wsHeight;
        // Limit movement alltogether
        if (curveObj.curve.getAttribute("DisableMoveX").toLowerCase() == "true") xPos = bp.xPos;
        if (curveObj.curve.getAttribute("DisableMoveY").toLowerCase() == "true") yPos = bp.yPos;
        // Limit within last and next bps
        var prevBp = curveObj.bps[bp.bpNum-1];
        var nextBp = curveObj.bps[bp.bpNum+1];
        if (prevBp && prevBp.visible && xPos < prevBp.xPos) xPos = prevBp.xPos;
        if (nextBp && nextBp.visible && xPos > nextBp.xPos) xPos = nextBp.xPos;
        
        // Calc and store value from pixels (rounded in steps)
        var newX = curveObj.minX + (Math.round((xPos/curveObj.pxUnitX)/curveObj.step) * curveObj.step);
        var newY = (Math.round(((yPos/curveObj.pxUnitY)-curveObj.maxY)/curveObj.step) * curveObj.step) / -1;
        
        // If new value, store positions and move point
        if(bp.x != newX) {
            bp.newX = newX;
            bp.node.setAttribute("Left", bp.xPos = xPos);
        }
        if(bp.y != newY) {
            bp.newY = newY;
            bp.node.setAttribute("Top", bp.yPos = yPos);
        }
        
        // Update unsaved polyline
        this._drawPolyline(curveObj.ws, curveObj.bps, true);
        // Set tooltip
        bp.node.setAttribute("Tooltip", "X"+bp.bpNum+": " + bp.newX.toFixed(curveObj.decimalsX) + "\nY"+bp.bpNum+": " + bp.newY.toFixed(curveObj.decimalsY));
    },
    save: function(curveObj) {
        /* Function that is triggerd by toolbar button */
        if(!confirm("Vill du spara den grafiskt ändrade kurvan?"))
            return;
            
        // Save points
        for(var bpNum in curveObj.bps) {
            var bp = curveObj.bps[bpNum];
            if (!isNaN(bp.newX)) {
                setValue(bp.xBind.getFullBindName(), bp.newX);
                delete bp.newX;
            }
            if (!isNaN(bp.newY)) {
                setValue(bp.yBind.getFullBindName(), bp.newY);
                delete bp.newY;
            }
        }

        // Disable buttons
        curveObj.node.getChild("Toolbar").getChild("Save").setAttribute("Visibility", "Hidden");
        curveObj.node.getChild("Toolbar").getChild("Revert").setAttribute("Visibility", "Hidden");
    },
    revert: function(curveObj) {
        /* Function that is triggerd by toolbar button */
        // Revert points
        for(var bpNum in curveObj.bps) {
            var bp = curveObj.bps[bpNum];
            if(!bp.visible) continue;
            bp.node.setAttribute("Left", bp.xPos = bp.xPosOld);
            bp.node.setAttribute("Top", bp.yPos = bp.yPosOld);
            bp.node.setAttribute("Tooltip", "X"+bpNum+": " + bp.x.toFixed(curveObj.decimalsX) + "\nY"+bpNum+": " + bp.y.toFixed(curveObj.decimalsY));
            delete bp.newX;
            delete bp.newY;
        }
        // Revert curve
        this._drawPolyline(curveObj.ws, curveObj.bps, false);
        
        // Disable buttons
        curveObj.node.getChild("Toolbar").getChild("Save").setAttribute("Visibility", "Hidden");
        curveObj.node.getChild("Toolbar").getChild("Revert").setAttribute("Visibility", "Hidden");
    },
    _drawPolyline: function(ws, bpArr, unsavedOnly) {
        var wsWidth = Number(ws.getAttribute("Width"));
        var wsHeight = Number(ws.getAttribute("Height"));
        
        // Find coordinates of break points for polyline
        var points = [];
        for (var bpNum in bpArr) {
            var bp = bpArr[bpNum];
            if (bp.visible) points.push(bp.xPos + "," + bp.yPos);
        }
        if (points.length > 1) {
            // Calculate endponts of polyline
            if(Number(ws.getAttribute("CurveLimit")))
            {
                // Limit endpoints to flat lines
                points.unshift("0,"+points[0].split(",")[1]);
                points.push(wsWidth + "," + points[points.length-1].split(",")[1]);
            }
            else
            {
                // Find leanfactor and extrapolate endpoints
                // First bp
                var point1 = [Number(points[0].split(",")[0]), Number(points[0].split(",")[1])];
                var point2 = [Number(points[1].split(",")[0]), Number(points[1].split(",")[1])];
                var lean = (point1[1]-point2[1])/(point2[0]-point1[0]);
                var x = 0;
                var y = point1[1]+(point1[0]*lean);
                if(isNaN(y)) y = lean === Infinity ? wsHeight : 0; // Fix if above return NaN due (0*Infinity)
                // Limit extrapolation within WS
                if(y < 0) {
                    x += y/lean;
                    if(isNaN(x)) x = point2[0];
                    y = 0;
                }
                else if(y > wsHeight) {
                    x += (y-wsHeight)/lean;
                    if(isNaN(x)) x = point2[0];
                    y = wsHeight;
                }
                points.unshift(x +","+ y);
                
                // Last bp
                var point1 = [Number(points[points.length-1].split(",")[0]), Number(points[points.length-1].split(",")[1])];
                var point2 = [Number(points[points.length-2].split(",")[0]), Number(points[points.length-2].split(",")[1])];
                var lean = (point2[1]-point1[1])/(point1[0]-point2[0]);
                var x = wsWidth;
                var y = point1[1]-((wsWidth-point1[0])*lean);
                if(isNaN(y)) y = lean === -Infinity ? wsHeight : 0; // Fix if above return NaN due (0*Infinity)
                // Limit extrapolation within WS
                if(y < 0) {
                    x += y/lean;
                    if(isNaN(x)) x = point2[0];
                    y = 0;
                }
                else if(y > wsHeight) {
                    x += (y-wsHeight)/lean;
                    if(isNaN(x)) x = point2[0];
                    y = wsHeight;
                }
                points.push(x +","+ y);
            }
            
            // Draw the polylines
            if(!unsavedOnly) ws.getChild("Polyline").setAttribute("Points",points.join(" "));
            ws.getChild("PolylineUnsaved").setAttribute("Points",points.join(" "));
            ws.getChild("PolylineUnsaved").setAttribute("Visibility",unsavedOnly?"Visible":"Hidden");
        }
    }
};

function Curve(node) {
    /* Function for setting up the curve, only needs to be run once per curve. */
    // Get all elements
    this.node = node;
    this.curve = node.getChild("Kurva");
    this.ws = this.curve.getChild("Workspace");
    this.table = node.getChild("Tabell");
    this.table.setAttribute("Name", "");
    this.currentXNode = this.curve.getChild("CurrentX");
    this.currentYNode = this.curve.getChild("CurrentY");
    this.bps = [];         // Array to store the break points
    this.tableBps = [];    // Array to store the break points

    this.minX = Number(node.getChild("MinX").getAttribute("Value"));
    this.maxX = Number(node.getChild("MaxX").getAttribute("Value"));
    this.minY = Number(node.getChild("MinY").getAttribute("Value"));
    this.maxY = Number(node.getChild("MaxY").getAttribute("Value"));
    this.wsWidth = Number(this.ws.getAttribute("Width"));
    this.wsHeight = Number(this.ws.getAttribute("Height"));
    this.wsLeft = Number(this.ws.getAttribute("Left"));
    this.wsTop = Number(this.ws.getAttribute("Top"));
    var spanX = this.maxX - this.minX;
    var spanY = this.maxY - this.minY;
    this.pxUnitX = this.wsWidth/spanX;
    this.pxUnitY = this.wsHeight/spanY;
    this.decimalsX = Number(node.getChild("DecimalsX").getAttribute("Value"));
    this.decimalsY = Number(node.getChild("DecimalsY").getAttribute("Value"));

    // Set labels
    this.curve.getChildByName("MinX").setAttribute("Content", this.minX.toFixed(this.decimalsX));
    this.curve.getChildByName("KvartX").setAttribute("Content", (this.minX+(spanX*0.25)).toFixed(this.decimalsX));
    this.curve.getChildByName("MedelX").setAttribute("Content", (this.minX+(spanX*0.5)).toFixed(this.decimalsX));
    this.curve.getChildByName("TrekvartX").setAttribute("Content", (this.minX+(spanX*0.75)).toFixed(this.decimalsX));
    this.curve.getChildByName("MaxX").setAttribute("Content", this.maxX.toFixed(this.decimalsX));
    this.curve.getChildByName("MinY").setAttribute("Content", this.minY.toFixed(this.decimalsY));
    this.curve.getChildByName("KvartY").setAttribute("Content", (this.minY+(spanY*0.25)).toFixed(this.decimalsY));
    this.curve.getChildByName("MedelY").setAttribute("Content", (this.minY+(spanY*0.5)).toFixed(this.decimalsY));
    this.curve.getChildByName("TrekvartY").setAttribute("Content", (this.minY+(spanY*0.75)).toFixed(this.decimalsY));
    this.curve.getChildByName("MaxY").setAttribute("Content", this.maxY.toFixed(this.decimalsY));
    this.curve.getChildByName("LabelX").setAttribute("Content", node.getChild("LabelX").getAttribute("Value"));
    this.curve.getChildByName("LabelY").setAttribute("Content", node.getChild("LabelY").getAttribute("Value"));
    this.table.getChildByName("LabelX").setAttribute("Content", node.getChild("LabelX").getAttribute("Value"));
    this.table.getChildByName("LabelY").setAttribute("Content", node.getChild("LabelY").getAttribute("Value"));

    // Calc number of gridlines
    var gridX = Number(node.getChild("GridX").getAttribute("Value"));
    if(gridX > 0) {
        // Calculate number of gridlines needed to get selected scale
        gridX = spanX / gridX;
    }
    else {
        // No grid scale set, estimate it
        gridX = spanX;
        for(var i = 0; i < spanX; i++)
            if (spanX % i == 0) gridX = i;
    }
    var gridY = Number(node.getChild("GridY").getAttribute("Value"));
    if(gridY > 0) {
        // Calculate number of gridlines needed to get selected scale
        gridY = spanY / gridY;
    }
    else {
        // No grid scale set, estimate it
        gridY = spanY;
        for(var i = 0; i < spanY; i++)
            if (spanY % i == 0) gridY = i;
    }
    // Paint the grid as per calculations
    paintGrid(this.curve.getChild("Grid"), gridX, gridY, true);
}
Curve.prototype.getPxLeft = function(value) {
    // Calc left pixels from value, relative to the workspace
    var pxLeft = (value-this.minX)*this.pxUnitX;
    if (pxLeft < 0) pxLeft = 0;
    else if (pxLeft > this.wsWidth) pxLeft = this.wsWidth;
    return pxLeft;
}
Curve.prototype.getPxTop = function(value) {
    // Calc top pixels from value, relative to the workspace
    var pxTop = ((value-this.maxY)*this.pxUnitY)/-1;
    if (pxTop < 0) pxTop = 0;
    else if (pxTop > this.wsHeight) pxTop = this.wsHeight;
    return pxTop;
}

function Point(curveObj, node, bpNum, type) {
    this.curveObj = curveObj;
    this.node = node;
    this.type = type;
    this.bpNum = bpNum;
    this.x = null;
    this.y = null;
    this.xPos = this.xPosOld = Number(node.getAttribute("Left"));
    this.yPos = this.yPosOld = Number(node.getAttribute("Top"));
    this.visible = false;
}
Point.prototype.show = function() {
    if(this.visible) return;
    this.node.setAttribute("Visibility", "Visible");
    this.visible = true;
}
    
function paintGrid(target, numX, numY, skipBorder) {
    // PaintGrid params
    // target = element that will receive grid (grid will fill this element)
    // numX = how many vertical lines to paint
    // numY = how many horizontal lines to paint

    var gridWidth = Number(target.getAttribute("Width"));
    var gridHeight = Number(target.getAttribute("Height"));
    var pathData = "";
    var px = 0;
    for(var i = 0; i <= Number(numX); i++)
    {
        if (skipBorder && (i == 0 || i == numX)) continue;
        px = (gridWidth/Number(numX))*i;
        pathData += "M " + px +",0 L " + px + " "+ gridHeight;
    }
    for(var i = 0; i <= Number(numY); i++)
    {
        if (skipBorder && (i == 0 || i == numY)) continue;
        px = (gridHeight/Number(numY))*i;
        pathData += "M 0," + px +" L "+ gridWidth +"," + px;
    }
    
    var path = target.getOwnerDocument().createElement("Path");
    path.setAttribute("PathData", pathData);
    path.setAttribute("Fill", "None");
    if (!target.hasAttribute("Stroke"))
        path.setAttribute("Stroke", "#E0E0E0"); // Fill set by attributeinheritance from component
    path.setAttribute("StrokeWidth", "0.1");

    target.appendChild(path);
}

function OnDocumentLoad(evt) { ModuleMaster.register(module, evt, init); }
]]></Script>
