  "bugs": {
    "url": "https://github.com/AntonPaalsson/ECOBUILDING-AI/issues"
  },
  "homepage": "https://github.com/AntonPaalsson/ECOBUILDING-AI#readme",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/cli": "^4.3.5",
    "daisyui": "^5.8.0",
    "tailwindcss": "^4.3.5"
  }
}
