    if (link) invoke(link.getFullBindName(), "OpenInFloatingWindow");// Width=800 | Height=720 | Top=160 | Left=612 | ShowToolBar=No");
}

function OnMouseOver(evt)
{
	var comp = evt.getCurrentTarget();
	comp.getChild("Bg").setAttribute("Fill", "#F9F8FB");
}

function OnMouseOut(evt)
{
	var comp = evt.getCurrentTarget();
	comp.getChild("Bg").setAttribute("Fill", "#FFFFFF");
}

function OnMouseDown(evt)
{
	var comp = evt.getCurrentTarget();
	comp.getChild("Bg").setAttribute("Fill", "#E0E0E0");
}

function OnMouseUp(evt)
{
	OnMouseOver(evt);
}]]></Script>
