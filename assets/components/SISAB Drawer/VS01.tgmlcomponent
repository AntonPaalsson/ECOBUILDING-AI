                            <Bind Name="Komp.Value">
                                <Script OnSignalChange="OnChange"><![CDATA[var v,l
function OnChange(evt)
{
    //Get value from binding, updates with changes.
    value = (evt.getValue());
    //Get bar from graphic
    bar = evt.target.parentNode.parentNode.parentNode.getChildByName("Bar");
    
    //Translate values between -5 and 5 to 0 and 100
    moveValue = value*10 + 50;

    //Handle values under -5
    if (value<-5)
    {
        bar.setAttribute("Opacity",0);
    }
    //Handle values above 5
    else if (value>5)
    {
        bar.setAttribute("Opacity",1);
        evt.target.parentNode.parentNode.setAttribute("Left",100);
        bar.setAttribute("Width",100);
    }
    //Set the bar and slider marker depending on value.
    else
    {
        bar.setAttribute("Opacity",1);
        evt.target.parentNode.parentNode.setAttribute("Left",moveValue);
        bar.setAttribute("Width",moveValue);
    }
 }]]></Script>
                            </Bind>
