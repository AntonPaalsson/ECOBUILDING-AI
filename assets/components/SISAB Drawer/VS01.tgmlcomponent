                            <Script OnSignalChange="OnChange"><![CDATA[var v,b,a,d,k;
function OnChange(evt)
{
    
    
    if (evt.target.getAttribute("Id") == "BB")
        b = Number(evt.getValue());
    else if
        (evt.target.getAttribute("Id") == "DI")
        d = Number(evt.getValue());
    else if
        (evt.target.getAttribute("Id") == "MV")
         v = Number(evt.getValue());     
        
    if (v&&b){
        
        var k = Number(evt.target.parentNode.parentNode.getAttribute("Dödzon")/b*4);
        
        a = ((v-b)/b/k*90+270)
        if (a > 360) a = 360               
        if (a < 180) a = 180 
        if ((a == 180 | a == 360 & d == 1)) {
            evt.target.parentNode.setAttribute("Stroke","#FF0000");
            evt.target.parentNode.getChildByName("OutOfLimit").setAttribute("Animation","Start");
        }    
        else {
            evt.target.parentNode.setAttribute("Stroke","#006699");
            evt.target.parentNode.getChildByName("OutOfLimit").setAttribute("Animation","Stop");
        }    
            
        evt.target.parentNode.setAttribute("StartAngle",a);
        
   
    }

 }]]></Script>
